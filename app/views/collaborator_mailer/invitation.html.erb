<% content_for :title, _("You're invited to %{name}", name: @tool.name) %>
<% content_for :preheader, _("%{inviter} invited you to collaborate on %{tool} in %{app_name}.", inviter: @inviter.name, tool: @tool.name, app_name: app_name) %>
<% content_for :footer_context, @tool.name %>

<h1 class="email-heading" style="margin: 0 0 16px; font-size: 19px; font-weight: 600; color: <%= mail_color(:text) %>;"><%= _("You're invited to collaborate") %></h1>

<p style="margin: 0 0 24px;">
  <strong><%= @inviter.name %></strong> <%= _("invited you to collaborate on") %>
  <strong><%= @tool.name %></strong> <%= _("in %{app_name}.", app_name: app_name) %>
</p>

<p style="margin: 0 0 28px;">
  <%= render "shared/mailer_button", text: _("Accept invitation"), url: @accept_url %>
</p>

<p class="muted-text" style="margin: 0; font-size: 13px; color: <%= mail_color(:muted) %>;">
  <%= _("This invitation expires in 7 days. If you don't have an account yet, you'll be able to create one when you accept.") %>
</p>
