<% content_for :title, _("Reset your password") %>
<% content_for :preheader, _("Reset your %{app_name} password. This link expires in %{time}.", app_name: app_name, time: distance_of_time_in_words(0, @user.password_reset_token_expires_in)) %>

<h1 class="email-heading" style="margin: 0 0 16px; font-size: 19px; font-weight: 600; color: <%= mail_color(:text) %>;"><%= _("Reset your password") %></h1>

<p style="margin: 0 0 24px;">
  <%= _("We received a request to reset the password for your %{app_name} account (%{email_address}).", app_name: app_name, email_address: @user.email_address) %>
</p>

<p style="margin: 0 0 28px;">
  <%= render "shared/mailer_button", text: _("Reset password"), url: edit_password_url(@user.password_reset_token) %>
</p>

<p class="muted-text" style="margin: 0 0 8px; font-size: 13px; color: <%= mail_color(:muted) %>;">
  <%= _("This link expires in %{password_reset_token_expires_in}.", password_reset_token_expires_in: distance_of_time_in_words(0, @user.password_reset_token_expires_in)) %>
</p>

<p class="muted-text" style="margin: 0; font-size: 13px; color: <%= mail_color(:muted) %>;">
  <%= _("If you didn't request this, you can safely ignore this email — your password won't change.") %>
</p>
