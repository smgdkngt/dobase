<% content_for :title, _("Invitation - %{app_name}", app_name: app_name) %>

<div class="flex items-center justify-center min-h-full py-12">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
      <h1 class="text-2xl font-semibold text-text-primary"><%= _("You're invited") %></h1>
      <p class="text-text-secondary mt-1">
        <strong><%= @inviter.name %></strong> <%= _("invited you to collaborate on") %>
      </p>
    </div>

    <div class="auth-card">
      <div class="card-body text-center">
        <div class="flex items-center justify-center gap-3 mb-4">
          <% if @tool.emoji_icon %>
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center text-xl">
              <%= @tool.emoji_icon %>
            </div>
          <% else %>
            <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
              <%= render "shared/icon", name: @tool.tool_type.icon, size: 20, class: "text-accent" %>
            </div>
          <% end %>
          <span class="text-lg font-semibold text-text-primary"><%= @tool.display_name %></span>
        </div>

        <p class="text-sm text-text-secondary mb-6">
          <%= _("Joining gives you access to this %{kind}.", kind: @tool.tool_type.human_name.downcase) %>
        </p>

        <div class="flex flex-col gap-2">
          <% if @invitation.for?(current_user) %>
            <%= form_with url: invitation_acceptance_path(token: @invitation.token) do %>
              <%= render "components/button", text: _("Accept Invitation"), full_width: true %>
            <% end %>
          <% else %>
            <p class="text-sm text-text-secondary mb-2">
              <%= _("This invitation is for %{invited}, and you're signed in as %{email_address}. Sign in with %{email} to accept it.", invited: tag.strong(@invitation.email), email_address: current_user.email_address, email: @invitation.email) %>
            </p>
          <% end %>
          <%= render "components/button",
                text: _("Decline"),
                variant: :ghost,
                href: invitation_acceptance_path(token: @invitation.token),
                method: :delete,
                full_width: true %>
        </div>
      </div>
    </div>
  </div>
</div>
