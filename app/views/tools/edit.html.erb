<% content_for :title, _("Edit %{name} - %{app_name}", name: @tool.name, app_name: app_name) %>
<% content_for :page_title, _("Edit Tool") %>

<%
  collabs = @tool.collaborators.includes(:user).order(Arel.sql("CASE WHEN role = 'owner' THEN 0 ELSE 1 END"), :created_at)
  pending_invitations = @tool.invitations.active.order(created_at: :desc)
  declined_invitations = @tool.invitations.declined.order(updated_at: :desc)
  is_mail_tool = @tool.tool_type.slug == "mail"
  mail_account = @tool.mail_account if is_mail_tool
  is_calendar_tool = @tool.tool_type.slug == "calendar"
  calendar_account = @tool.calendar_account if is_calendar_tool
  # Saving the mail account failed: show what went wrong
  default_tab = mail_account&.errors&.any? ? "email" : "settings"
%>

<%# A failed save renders these settings as a page of their own, outside the modal %>
<% unless turbo_frame_request? %>
  <div class="p-6"><div class="max-w-3xl mx-auto card overflow-hidden">
    <div class="card-header"><h2 class="text-lg font-semibold"><%= _("Edit %{tool_name}", tool_name: @tool.name) %></h2></div>
<% end %>
<%= turbo_frame_tag "edit-tool-form" do %>
  <div data-controller="tabs" data-tabs-default-value="<%= default_tab %>" <%= tag.attributes("data-tabs-open-value": @open_tab) %> class="edit-modal-layout flex <%= turbo_frame_request? ? '-m-5 h-[500px]' : '' %>">
    <%# Vertical tab navigation (horizontal on mobile) %>
    <div class="edit-modal-tabs flex flex-col gap-1 w-44 flex-shrink-0 p-4 border-e border-border-light bg-background-secondary/50">
      <button type="button" class="tab w-full justify-start" data-tabs-target="tab" data-tab="settings" data-action="click->tabs#select">
        <%= render "shared/icon", name: "settings", size: 16 %>
        <span><%= _("Settings") %></span>
      </button>
      <% if is_mail_tool && mail_account %>
        <button type="button" class="tab w-full justify-start" data-tabs-target="tab" data-tab="email" data-action="click->tabs#select">
          <%= render "shared/icon", name: "mail", size: 16 %>
          <span><%= _("Email") %></span>
        </button>
      <% end %>
      <% if is_calendar_tool && calendar_account %>
        <button type="button" class="tab w-full justify-start" data-tabs-target="tab" data-tab="calendar" data-action="click->tabs#select">
          <%= render "shared/icon", name: "calendar", size: 16 %>
          <span><%= _("Calendar") %></span>
        </button>
      <% end %>
      <button type="button" class="tab w-full justify-start" data-tabs-target="tab" data-tab="collaborators" data-action="click->tabs#select">
        <%= render "shared/icon", name: "users", size: 16 %>
        <span><%= _("Collaborators") %></span>
        <% if collabs.any? || pending_invitations.any? %>
          <%= render "components/badge", text: collabs.count + pending_invitations.count, size: :sm %>
        <% end %>
      </button>

      <%# Danger actions — desktop: bottom of sidebar; mobile: inline in tab row %>
      <% can_leave = !@tool.owned_by?(current_user) || @tool.collaborators.owners.count > 1 %>
      <div class="mt-auto pt-2 border-t border-border-light flex flex-col gap-1 max-lg:hidden">
        <% if can_leave %>
          <%= render "components/button",
                text: _("Leave"),
                variant: :ghost,
                icon: "log-out",
                size: :sm,
                class: "text-error w-full justify-start",
                href: leave_tool_collaborators_path(@tool),
                method: :delete,
                turbo_confirm: _("Are you sure you want to leave %{name}?", name: @tool.name),
                data: { turbo_frame: "_top", turbo_confirm_button: _("Leave") } %>
        <% end %>
        <% if @tool.owned_by?(current_user) %>
          <%= render "components/button",
                text: _("Delete"),
                variant: :ghost,
                icon: "trash-2",
                size: :sm,
                class: "text-error w-full justify-start",
                href: tool_path(@tool),
                method: :delete,
                turbo_confirm: _("Are you sure you want to delete this tool? This action cannot be undone."),
                data: { turbo_frame: "_top", turbo_confirm_button: _("Delete") } %>
        <% end %>
      </div>
      <% if can_leave %>
        <%= link_to leave_tool_collaborators_path(@tool),
              class: "tab tab-danger w-full justify-start lg:hidden",
              data: { turbo_method: :delete, turbo_confirm: _("Are you sure you want to leave %{name}?", name: @tool.name), turbo_confirm_button: _("Leave"), turbo_frame: "_top" } do %>
          <%= render "shared/icon", name: "log-out", size: 16 %>
          <span><%= _("Leave") %></span>
        <% end %>
      <% end %>
      <% if @tool.owned_by?(current_user) %>
        <%= link_to tool_path(@tool),
              class: "tab tab-danger w-full justify-start lg:hidden",
              data: { turbo_method: :delete, turbo_confirm: _("Are you sure you want to delete this tool? This action cannot be undone."), turbo_confirm_button: _("Delete"), turbo_frame: "_top" } do %>
          <%= render "shared/icon", name: "trash-2", size: 16 %>
          <span><%= _("Delete") %></span>
        <% end %>
      <% end %>
    </div>

    <%# Panel content %>
    <div class="edit-modal-content flex-1 py-4 pe-5 ps-5 overflow-y-auto">
      <%# Settings panel %>
      <div data-tabs-target="panel" data-tab="settings">
        <%= form_with model: @tool, data: { turbo_frame: "_top" } do |f| %>
          <%= render "shared/error_flash", object: @tool %>

          <div class="mb-4">
            <p class="label"><%= _("Tool Type") %></p>
            <div class="flex items-center gap-3 p-3 bg-background-secondary rounded-lg">
              <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
                <%= render "shared/icon", name: @tool.tool_type.icon, size: 20, class: "text-accent" %>
              </div>
              <span class="font-medium"><%= @tool.tool_type.human_name %></span>
            </div>
            <p class="help-text"><%= _("Tool type cannot be changed after creation") %></p>
          </div>

          <div class="mb-5">
            <%= f.label :name, _("Name"), class: "label" %>
            <%= f.text_field :name,
              class: "input #{@tool.errors[:name].any? ? 'input-error' : ''}",
              required: true
            %>
            <p class="help-text"><%= _("Start with an emoji to use it as the icon, like 🚀 Updates") %></p>
          </div>

          <div class="flex items-center justify-end pt-4 border-t border-border-light">
            <%= render "components/button", text: _("Save Changes") %>
          </div>
        <% end %>

        <%# Per-user notification mute %>
        <% muted = @tool.muted_by?(current_user) %>
        <div class="mt-5 pt-4 border-t border-border-light">
          <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
              <h3 class="text-sm font-semibold text-text-primary"><%= _("Notifications") %></h3>
              <p class="text-xs text-text-secondary mt-0.5">
                <% if muted %>
                  <%= _("You won't get notifications, emails, or activity dots from this tool.") %>
                <% else %>
                  <%= _("Mute to stop receiving notifications, emails, and sidebar activity dots from this tool.") %>
                <% end %>
              </p>
            </div>
            <% if muted %>
              <%= button_to tool_mute_path(@tool), method: :delete,
                    class: "btn btn-secondary btn-sm flex-shrink-0",
                    data: { turbo_frame: "_top" } do %>
                <%= render "shared/icon", name: "bell", size: 14 %>
                <span><%= _("Unmute") %></span>
              <% end %>
            <% else %>
              <%= button_to tool_mute_path(@tool), method: :post,
                    class: "btn btn-secondary btn-sm flex-shrink-0",
                    data: { turbo_frame: "_top" } do %>
                <%= render "shared/icon", name: "bell-off", size: 14 %>
                <span><%= _("Mute") %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <% if is_mail_tool && mail_account %>
        <%# Email settings panel %>
        <div data-tabs-target="panel" data-tab="email" class="hidden">
          <%= form_with model: mail_account, url: tool_mails_account_path(@tool), method: :patch, data: { turbo_frame: "_top" } do |f| %>
            <%= render "shared/error_flash", object: mail_account %>

            <%# Account Details %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Account Details") %></h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <%= f.label :email_address, _("Email Address"), class: "label" %>
                  <%= f.email_field :email_address, class: "input", required: true %>
                </div>
                <div>
                  <%= f.label :display_name, _("Display Name"), class: "label" %>
                  <%= f.text_field :display_name, class: "input", placeholder: _("John Doe") %>
                </div>
              </div>
            </div>

            <%# Credentials %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Credentials") %></h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <%= f.label :username, _("Username"), class: "label" %>
                  <%= f.text_field :username, class: "input", required: true %>
                </div>
                <div>
                  <%= f.label :password, _("Password"), class: "label" %>
                  <%= f.password_field :password, class: "input", placeholder: _("Leave blank to keep current") %>
                </div>
              </div>
            </div>

            <%# IMAP Settings %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("IMAP Settings") %></h3>
              <div class="grid grid-cols-4 gap-3">
                <div class="col-span-3">
                  <%= f.label :imap_host, _("IMAP Server"), class: "label" %>
                  <%= f.text_field :imap_host, class: "input", required: true %>
                </div>
                <div>
                  <%= f.label :imap_port, _("Port"), class: "label" %>
                  <%= f.number_field :imap_port, class: "input" %>
                </div>
              </div>
              <label class="flex items-center gap-2 mt-2 cursor-pointer">
                <%= f.check_box :imap_ssl, class: "w-4 h-4 rounded border-border text-accent" %>
                <span class="text-sm text-text-primary"><%= _("Use SSL/TLS") %></span>
              </label>
            </div>

            <%# SMTP Settings %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("SMTP Settings") %></h3>
              <div class="grid grid-cols-4 gap-3">
                <div class="col-span-3">
                  <%= f.label :smtp_host, _("SMTP Server"), class: "label" %>
                  <%= f.text_field :smtp_host, class: "input", required: true %>
                </div>
                <div>
                  <%= f.label :smtp_port, _("Port"), class: "label" %>
                  <%= f.number_field :smtp_port, class: "input" %>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3 mt-3">
                <div>
                  <%= f.label :smtp_auth, _("Authentication"), class: "label" %>
                  <%= f.select :smtp_auth, [[_("Plain"), "plain"], [_("Login"), "login"], ["CRAM-MD5", "cram_md5"]], {}, class: "input" %>
                </div>
                <div class="flex items-end pb-2">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <%= f.check_box :smtp_tls, class: "w-4 h-4 rounded border-border text-accent" %>
                    <span class="text-sm text-text-primary"><%= _("Use STARTTLS") %></span>
                  </label>
                </div>
              </div>
            </div>

            <%# Signature %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Email Signature") %></h3>
              <%= f.text_area :signature, class: "input min-h-[80px]", rows: 3, "aria-label": _("Email signature"), placeholder: _("Your name\nYour title") %>
            </div>

            <%# Archive folder %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Archive Folder") %></h3>
              <%= f.text_field :archive_folder, class: "input", "aria-label": _("Archive folder"), placeholder: _("Archive") %>
              <p class="help-text"><%= _("IMAP folder to move archived emails to. Left blank, the server's archive folder is used, or archiving only marks mail as read if it has none.") %></p>
            </div>

            <%# Auto-refresh %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Auto-refresh") %></h3>
              <%# Unset means the mail page's default of a minute %>
              <%= f.select :auto_refresh_interval,
                [[_("Disabled"), 0], ["30 seconds", 30], ["1 minute", 60], ["2 minutes", 120], ["5 minutes", 300]],
                { selected: mail_account.auto_refresh_interval || 60 }, { class: "input", "aria-label": _("Auto-refresh interval") } %>
            </div>

            <%# Sync Status %>
            <div class="mb-5 p-3 bg-background-secondary rounded-lg">
              <div class="flex items-center justify-between">
                <div>
                  <h4 class="text-sm font-medium text-text-primary"><%= _("Sync Status") %></h4>
                  <p class="text-xs text-text-secondary mt-0.5">
                    <% if mail_account.last_synced_at %>
                      <%= _("Last synced: %{last_synced_at} ago", last_synced_at: time_ago_in_words(mail_account.last_synced_at)) %>
                    <% else %>
                      <%= _("Never synced") %>
                    <% end %>
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-2 h-2 rounded-full <%= mail_account.synced? ? 'bg-success' : (mail_account.sync_error? ? 'bg-error' : 'bg-warning') %>"></div>
                  <span class="text-sm capitalize"><%= _(mail_account.sync_status.to_s.capitalize) %></span>
                </div>
              </div>
              <% if mail_account.sync_error? && mail_account.sync_error.present? %>
                <p class="text-xs text-error mt-2"><%= mail_account.sync_error %></p>
              <% end %>
            </div>

            <div class="flex items-center justify-end pt-4 border-t border-border-light">
              <%= render "components/button", text: _("Save Changes") %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if is_calendar_tool && calendar_account %>
        <%# Calendar settings panel %>
        <div data-tabs-target="panel" data-tab="calendar" class="hidden">
          <%= form_with model: calendar_account, url: tool_calendar_account_path(@tool), method: :patch, data: { turbo_frame: "_top" } do |f| %>
            <%= render "shared/error_flash", object: calendar_account %>

            <%# Account Type %>
            <div class="mb-5">
              <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Account Type") %></h3>
              <div class="flex items-center gap-3 p-3 bg-background-secondary rounded-lg">
                <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center">
                  <%= render "shared/icon", name: calendar_account.local? ? "calendar" : "cloud", size: 20, class: "text-accent" %>
                </div>
                <div>
                  <span class="font-medium capitalize"><%= calendar_account.provider %></span>
                  <p class="text-xs text-text-secondary"><%= calendar_account.local? ? _("Events stored locally") : _("Synced via CalDAV") %></p>
                </div>
              </div>
            </div>

            <% unless calendar_account.local? %>
              <%# CalDAV Settings %>
              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("CalDAV Settings") %></h3>
                <div class="mb-3">
                  <label for="calendars_account_caldav_url" class="label"><%= _("CalDAV URL") %></label>
                  <%= f.text_field :caldav_url, class: "input", required: true %>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label for="calendars_account_username" class="label"><%= _("Username") %></label>
                    <%= f.text_field :username, class: "input", required: true %>
                  </div>
                  <div>
                    <label for="calendars_account_password" class="label"><%= _("Password") %></label>
                    <%= f.password_field :password, class: "input", placeholder: _("Leave blank to keep current") %>
                  </div>
                </div>
              </div>

              <%# Sync Status %>
              <div class="mb-5 p-3 bg-background-secondary rounded-lg">
                <div class="flex items-center justify-between">
                  <div>
                    <h4 class="text-sm font-medium text-text-primary"><%= _("Sync Status") %></h4>
                    <p class="text-xs text-text-secondary mt-0.5">
                      <% if calendar_account.last_synced_at %>
                        <%= _("Last synced: %{last_synced_at} ago", last_synced_at: time_ago_in_words(calendar_account.last_synced_at)) %>
                      <% else %>
                        <%= _("Never synced") %>
                      <% end %>
                    </p>
                  </div>
                  <div class="flex items-center gap-2">
                    <div class="w-2 h-2 rounded-full <%= calendar_account.synced? ? 'bg-success' : (calendar_account.sync_error? ? 'bg-error' : 'bg-warning') %>"></div>
                    <span class="text-sm capitalize"><%= _(calendar_account.sync_status.to_s.capitalize) %></span>
                  </div>
                </div>
                <% if calendar_account.sync_error? && calendar_account.sync_error.present? %>
                  <p class="text-xs text-error mt-2"><%= calendar_account.sync_error %></p>
                <% end %>
              </div>
            <% end %>

            <%# Calendars list %>
            <% calendars = calendar_account.calendars.by_position %>
            <% if calendars.any? %>
              <div class="mb-5">
                <h3 class="text-sm font-semibold text-text-primary mb-3"><%= _("Calendars") %></h3>
                <div class="space-y-2">
                  <% calendars.each do |calendar| %>
                    <div class="flex items-center gap-3 p-3 bg-background-secondary rounded-lg">
                      <input type="hidden" name="calendars_account[calendars_attributes][<%= calendar.id %>][id]" value="<%= calendar.id %>">
                      <input type="color"
                             aria-label="<%= _("Colour for %{name}", name: calendar.name) %>"
                             name="calendars_account[calendars_attributes][<%= calendar.id %>][color]"
                             value="<%= calendar.color_hex %>"
                             class="w-6 h-6 rounded cursor-pointer border-0 p-0">
                      <input type="text"
                             aria-label="<%= _("Name for %{name}", name: calendar.name) %>"
                             name="calendars_account[calendars_attributes][<%= calendar.id %>][name]"
                             value="<%= calendar.name %>"
                             class="flex-1 text-sm font-medium bg-transparent border-0 p-0 focus:outline-none focus:ring-0">
                      <% if calendar.is_default? %>
                        <span class="text-xs text-text-tertiary"><%= _("Default") %></span>
                      <% end %>
                      <label class="flex items-center gap-2 cursor-pointer">
                        <input type="hidden" name="calendars_account[calendars_attributes][<%= calendar.id %>][enabled]" value="0">
                        <input type="checkbox"
                               name="calendars_account[calendars_attributes][<%= calendar.id %>][enabled]"
                               value="1"
                               <%= "checked" if calendar.enabled? %>
                               class="w-4 h-4 rounded border-border text-accent">
                        <span class="text-xs text-text-secondary"><%= _("Visible") %></span>
                      </label>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div class="flex items-center justify-end pt-4 border-t border-border-light">
              <%= render "components/button", text: _("Save Changes") %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Collaborators panel %>
      <div data-tabs-target="panel" data-tab="collaborators" class="hidden">
        <%# Member list (owners + collaborators) %>
        <div class="mb-2">
          <h3 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-1"><%= _("Members") %></h3>
          <div id="collaborator-list" class="divide-y divide-border-light">
            <%= render partial: "shared/collaborator_row",
                  collection: collabs, as: :collaborator,
                  locals: { tool: @tool } %>
          </div>
        </div>

        <%# Pending invitations %>
        <% if pending_invitations.any? %>
          <div class="mb-2">
            <h3 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-1"><%= _("Pending invitations") %></h3>
            <div id="invitation-list" class="divide-y divide-border-light">
              <%= render partial: "shared/invitation_row",
                    collection: pending_invitations, as: :invitation,
                    locals: { tool: @tool } %>
            </div>
          </div>
        <% else %>
          <div id="invitation-list" class="hidden"></div>
        <% end %>

        <%# Declined invitations %>
        <% if declined_invitations.any? %>
          <div class="mb-2">
            <h3 class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-1"><%= _("Declined invitations") %></h3>
            <div id="declined-invitation-list" class="divide-y divide-border-light">
              <% declined_invitations.each do |invitation| %>
                <div class="flex items-center justify-between py-2 opacity-60">
                  <div class="collaborator-info">
                    <%= render "shared/avatar", initials: invitation.email[0].upcase, size: :md %>
                    <div>
                      <div class="collaborator-name">
                        <%= invitation.email %>
                        <span class="inline-block text-[0.625rem] font-semibold text-error bg-error/10 px-1.5 py-px rounded-full ms-1.5 uppercase tracking-wide"><%= _("Declined") %></span>
                      </div>
                      <div class="collaborator-email"><%= _("Declined %{updated_at} ago", updated_at: time_ago_in_words(invitation.updated_at)) %></div>
                    </div>
                  </div>
                  <% if @tool.owned_by?(current_user) %>
                    <%= button_to tool_resend_invitation_path(@tool, invitation),
                          method: :post,
                          class: "text-xs text-accent bg-transparent border-none cursor-pointer px-2 py-1 rounded-sm hover:bg-accent-light" do %>
                      <%= _("Reinvite") %>
                    <% end %>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%# Empty state %>
        <div id="collaborator-empty"
             class="text-center py-3 text-text-tertiary text-sm <%= (collabs.any? || pending_invitations.any? || declined_invitations.any?) ? 'hidden' : '' %>">
          <%= _("No collaborators yet. Add someone by email below.") %>
        </div>

        <% if @tool.owned_by?(current_user) %>
          <%# Add collaborator form (owners only). How an invitation went is said
              right here (CollaboratorsController#create), and a refused address stays. %>
          <div class="mt-4 pt-4 border-t border-border-light">
            <%= render "shared/flash", position: :inline %>
          </div>
          <%= form_with url: tool_collaborators_path(@tool),
                class: "flex gap-2 items-center" do |f| %>
            <div class="flex-1">
              <%= f.email_field :email, value: @email, class: "input", "aria-label": _("Collaborator email address"), placeholder: _("Enter email address…"), required: true %>
            </div>
            <%= render "components/button", text: _("Add"), icon: "plus" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<% unless turbo_frame_request? %>
  </div></div>
<% end %>
