<% content_for(:title) { _("Too Large to Download") } %>
<%= render "components/empty_state",
    icon: "archive",
    title: _("Too Large to Download"),
    description: _("%{name} is too large to download as a zip. Zips are limited to %{number_to_human_size} and %{number_with_delimiter} files. Please contact the person who shared it with you.", name: @share.shareable.name, number_to_human_size: number_to_human_size(Files::FolderArchive::MAX_BYTES), number_with_delimiter: number_with_delimiter(Files::FolderArchive::MAX_FILES)),
    action_text: _("Back to Folder"),
    action_href: share_path(@share.token),
    size: :lg %>
