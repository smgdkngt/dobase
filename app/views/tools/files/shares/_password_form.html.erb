<div class="max-w-[400px] text-center p-8">
  <div class="flex justify-center text-text-tertiary mb-6">
    <%= render "shared/icon", name: "lock", size: 48 %>
  </div>
  <h1 class="text-xl font-semibold mb-2"><%= _("Password Required") %></h1>
  <p class="text-text-secondary mb-6"><%= _("This shared content is password protected.") %></p>

  <%= form_with url: share_unlock_path(@share.token), class: "text-start" do %>
    <div class="mb-4">
      <label class="label" for="password"><%= _("Password") %></label>
      <input type="password" name="password" id="password" class="input" required autofocus>
      <% if @password_error %>
        <p class="text-error text-sm mt-1"><%= @password_error %></p>
      <% end %>
    </div>
    <%= render "components/button", text: _("Unlock"), variant: :primary, full_width: true %>
  <% end %>
</div>
