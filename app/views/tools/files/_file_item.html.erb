<%# locals: (file:, tool:, view_mode:, image_index: nil) %>
<%
  base_classes = "group relative cursor-pointer select-none transition-colors duration-150"
  grid_classes = "w-[calc(110px/var(--tile-zoom,1))] @min-[40rem]:w-[calc(140px/var(--tile-zoom,1))] p-3 @min-[40rem]:p-4 rounded-lg flex flex-col items-center gap-2 hover:bg-background-tertiary"
  list_classes = "flex items-center gap-3 px-4 py-3 border-b border-border-light hover:bg-background-tertiary"
  item_classes = view_mode == "grid" ? "#{base_classes} #{grid_classes}" : "#{base_classes} #{list_classes}"

  icon_base = "flex items-center justify-center shrink-0 rounded-xl transition-transform duration-150 group-hover:scale-105"
  icon_size = view_mode == "grid" ? "w-12 h-12 @min-[40rem]:w-16 @min-[40rem]:h-16" : "w-7 h-7 rounded-md"
%>
<div class="<%= item_classes %>"
     data-file-selection-target="item"
     data-file-drag-target="item"
     data-item-type="file"
     data-item-id="<%= file.id %>"
     data-presence-item="file:<%= file.id %>"
     data-item-url="<%= tool_files_item_path(tool, file) %>"
     draggable="true"
     role="button"
     tabindex="0"
     data-arrow-keys-target="item"
     aria-label="File <%= file.name %>"
     data-action="keydown->files#openItemKey click->file-selection#select click->file-drag#recordClick dblclick->files#openItem contextmenu->file-selection#selectForMenu contextmenu->file-context-menu#show dragstart->file-drag#dragStart dragend->file-drag#dragEnd">
  <% if file.image? && file.file.attached? %>
    <div class="<%= icon_base %> <%= icon_size %> overflow-hidden">
      <%= image_tag url_for(file.thumbnail), class: "w-full h-full object-cover", loading: "lazy", decoding: "async", alt: file.name %>
    </div>
  <% else %>
    <div class="<%= icon_base %> <%= icon_size %> file-icon">
      <%= render "shared/icon", name: file.icon_name, size: view_mode == "grid" ? 32 : 16 %>
    </div>
  <% end %>
  <% if view_mode == "grid" %>
    <span data-item-name class=" text-sm text-center line-clamp-2 break-words"><%= file.name %></span>
  <% else %>
    <div class="flex items-center gap-4 @min-[40rem]:gap-8 flex-1 min-w-0">
      <span data-item-name class=" flex-1 min-w-0 truncate text-sm @min-[40rem]:text-base"><%= file.name %></span>
      <span class="w-5 shrink-0 text-center hidden @min-[40rem]:block">
        <% if file.share %>
          <span class="text-accent"><%= render "shared/icon", name: "link", size: 14, label: "Shared" %></span>
        <% end %>
      </span>
      <span class="text-sm text-text-secondary w-[100px] text-right shrink-0 hidden @3xl:block"><%= file.human_file_size %></span>
      <span class="text-sm text-text-secondary w-[100px] text-right shrink-0 hidden @5xl:block"><%= format_date(file.created_at) %></span>
    </div>
  <% end %>
  <div class="<%= view_mode == 'grid' ? 'absolute top-2 right-2 opacity-0 group-hover:opacity-100 group-focus-within:opacity-100 transition-opacity' : '' %> flex items-center gap-2">
    <% if view_mode == "grid" && file.share %>
      <span class="text-accent">
        <%= render "shared/icon", name: "link", size: 14, label: "Shared" %>
      </span>
    <% end %>
    <% if image_index %>
      <button type="button" class="p-1 rounded text-text-tertiary hover:bg-background-tertiary hover:text-text-primary transition-all <%= 'opacity-0 group-hover:opacity-100 group-focus-within:opacity-100' if view_mode == 'grid' %>"
              data-action="click->gallery#open:stop" data-index="<%= image_index %>" title="View" aria-label="View <%= file.name %>">
        <%= render "shared/icon", name: "eye", size: 16 %>
      </button>
    <% end %>
    <button type="button" class="p-1 rounded text-text-tertiary hover:bg-background-tertiary hover:text-text-primary transition-all <%= 'opacity-0 group-hover:opacity-100 group-focus-within:opacity-100' if view_mode == 'grid' %>"
            aria-label="More actions for <%= file.name %>"
            aria-haspopup="menu"
            data-action="click->file-selection#selectForMenu click->file-context-menu#showFromButton:stop">
      <%= render "shared/icon", name: "more-vertical", size: 16 %>
    </button>
  </div>
</div>
