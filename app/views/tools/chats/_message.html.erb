<%
  tool = message.chat.tool

  # Timestamp formatting. A new or edited message is broadcast from one
  # person's request to everyone, so the browser puts the time in the viewer's zone
  time_ago = Time.current - message.created_at
  time = local_time_tag(message.created_at)
  if time_ago < 24.hours
    timestamp = time
  elsif time_ago < 48.hours
    timestamp = safe_join([ "Yesterday, ", time ])
  else
    timestamp = safe_join([ format_date(message.created_at), ", ", time ])
  end

  has_files = message.has_files?
  image_files = has_files ? message.image_files : []
  other_files = has_files ? message.other_files : []
  reply_to = message.reply_to

  # Check if this is a continuation of previous message (passed from parent)
  is_continuation = local_assigns.fetch(:is_continuation, false)
%>
<div id="<%= dom_id(message) %>"
     class="chat-message group/message flex gap-2.5 sm:gap-3 px-2 sm:px-4 py-1.5 sm:py-2 hover:bg-background-tertiary/50 <%= is_continuation ? '' : 'mt-2 sm:mt-3' %>"
     data-controller="message reactions"
     role="article"
     aria-label="Message from <%= poster_name(message) %>"
     data-arrow-keys-target="item"
     data-action="keydown->chat#messageKey"
     data-message-user-id-value="<%= message.user_id %>"
     data-reactions-url-value="<%= tool_chat_message_reactions_path(tool, message) %>"
     data-message-id="<%= message.id %>"
     data-message-author="<%= poster_name(message) %>"
     data-message-content="<%= truncate(message.body.to_plain_text, length: 100) %>">

  <!-- Avatar column -->
  <div class="chat-message-avatar flex-shrink-0 w-9 sm:w-11">
    <% unless is_continuation %>
      <%= render "shared/avatar", user: message.user, agent: message.agent?, size: :md, class: "sm:hidden" %><%= render "shared/avatar", user: message.user, agent: message.agent?, size: :xl, class: "hidden sm:inline-flex" %>
    <% else %>
      <!-- Hover timestamp for continuation messages -->
      <span class="hidden group-hover/message:block text-xs text-text-tertiary text-right leading-relaxed pt-[5px]">
        <%= local_time_tag(message.created_at, period: false) %>
      </span>
    <% end %>
  </div>

  <!-- Message content -->
  <div class="flex-1 min-w-0">
    <% unless is_continuation %>
      <!-- Header: name and timestamp -->
      <div class="flex items-baseline gap-2 mb-0.5">
        <%= render "shared/posted_by", record: message %>
        <span class="text-xs text-text-tertiary"><%= timestamp %></span>
      </div>
    <% end %>

    <% if reply_to %>
      <!-- Reply quote -->
      <div class="mb-2 pl-3 py-1.5 border-l-2 border-accent/50 bg-background-secondary/50 rounded-r">
        <div class="text-xs font-medium text-accent mb-0.5"><%= poster_name(reply_to) %></div>
        <div class="text-sm text-text-secondary line-clamp-2"><%= reply_to.body.to_plain_text.truncate(200) %></div>
      </div>
    <% end %>

    <%= render "tools/chats/message_body", message: message %>

    <% if image_files.any? %>
      <div class="flex flex-wrap gap-2 mt-2">
        <% image_files.each do |file| %>
          <%= link_to_file_preview tool, file, class: "block", title: file.filename.to_s do %>
            <%= image_tag rails_blob_path(file, disposition: "inline"),
                  alt: file.filename.to_s,
                  class: "w-[100px] h-[100px] rounded object-cover hover:opacity-90 transition-opacity",
                  loading: "lazy" %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if other_files.any? %>
      <div class="flex flex-wrap gap-2 mt-2">
        <% other_files.each do |file| %>
          <span class="inline-flex items-center gap-1 pr-1.5 rounded border border-border-light hover:bg-background-tertiary transition-colors">
            <%= link_to_file_preview tool, file, class: "inline-flex items-center gap-2 pl-3 py-1.5" do %>
              <%= render "shared/icon", name: "file", size: 16, class: "text-text-tertiary" %>
              <span class="text-sm text-text-primary"><%= file.filename.to_s %></span>
              <span class="text-xs text-text-tertiary"><%= human_file_size(file.byte_size) %></span>
            <% end %>
            <%= render "components/file_download_link", file: file %>
          </span>
        <% end %>
      </div>
    <% end %>

    <%= render "tools/chats/reactions", message: message %>
  </div>

  <%# Actions float over the top right corner on hover or tap, so they take no width from the text %>
  <div class="chat-message-actions">
    <div class="flex items-center bg-surface border border-border-light rounded-lg shadow-sm">
      <button type="button"
              class="icon-btn icon-btn-group-left"
              title="Add a reaction"
              aria-label="Add a reaction"
              popovertarget="<%= dom_id(message, :react) %>"
              style="anchor-name: --<%= dom_id(message, :react) %>">
        <%= render "shared/icon", name: "smile-plus", size: 16 %>
      </button>
      <%= render "components/icon_button",
            icon: "reply",
            title: "Reply",
            group: :middle,
            data: { action: "click->chat#startReply", message_id: message.id } %>
      <div class="hidden" data-message-edit>
        <%= render "components/icon_button",
              icon: "edit-2",
              title: "Edit",
              group: :middle,
              href: edit_tool_chat_message_path(tool, message),
              data: { turbo_frame: dom_id(message, :body) } %>
      </div>
      <div class="hidden" data-message-delete>
        <%= render "components/icon_button",
              icon: "trash-2",
              title: "Delete",
              variant: :danger,
              group: :right,
              href: tool_chat_message_path(tool, message),
              method: :delete,
              turbo_confirm: "Delete this message?",
              data: { turbo_confirm_button: "Delete" } %>
      </div>
    </div>
  </div>

  <%# Outside the hover bar, which is see-through until the pointer is on the message %>
  <div id="<%= dom_id(message, :react) %>"
       popover="auto"
       class="popover-menu chat-reaction-picker"
       style="position-anchor: --<%= dom_id(message, :react) %>; position-area: block-start span-inline-start">
    <% Chats::Reaction::EMOJI.each do |emoji| %>
      <button type="button" class="chat-reaction-choice" data-emoji="<%= emoji %>" data-action="reactions#pick" aria-label="React with <%= emoji %>"><%= emoji %></button>
    <% end %>
  </div>
</div>
