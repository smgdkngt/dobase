<% content_for :title, "All Tools - #{app_name}" %>
<% content_for :page_title, "All Tools" %>

<div class="p-6">
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-semibold text-text-primary">All Tools</h1>
    <p class="text-text-secondary">Manage all your tools in one place.</p>
  </div>
  <%= render "components/button", text: "Add Tool", icon: "plus", href: new_tool_path %>
</div>

<% if @tools.any? %>
  <div class="card">
    <div class="divide-y divide-border-light">
      <% @tools.each do |tool| %>
        <div class="card-row group px-5 py-4 flex items-center gap-4">
          <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center flex-shrink-0 transition-transform duration-150 group-hover:scale-105">
            <%= render "shared/icon", name: tool.tool_type.icon, size: 20, class: "text-accent" %>
          </div>
          <div class="flex-1 min-w-0">
            <%= link_to tool_path(tool), class: "font-medium text-text-primary hover:text-accent after:absolute after:inset-0" do %>
              <%= tool.name %>
            <% end %>
            <p class="text-sm text-text-secondary"><%= tool.tool_type.name %></p>
          </div>
          <% if @owned_tool_ids.include?(tool.id) %>
            <span class="text-xs text-text-tertiary">Owner</span>
          <% else %>
            <%= render "components/badge", text: "Shared", variant: :muted, size: :sm %>
          <% end %>
          <%= render "shared/icon", name: "chevron-right", size: 16, class: "text-text-tertiary flex-shrink-0" %>
        </div>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="card">
    <%= render "components/empty_state",
        title: "No tools yet",
        description: "Get started by adding your first tool.",
        icon: "layout",
        size: :md,
        action_text: "Add Your First Tool",
        action_href: new_tool_path,
        action_icon: "plus" %>
  </div>
<% end %>
</div>
