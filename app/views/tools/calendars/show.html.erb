<% content_for :title, "#{@tool.name} - #{app_name}" %>
<% content_for :page_title, "" %>

<% content_for :command_palette_actions do %>
  <%= render "shared/command_palette_action", key: "n", description: _("New event"), icon: "plus" %>
  <%= render "shared/command_palette_action", key: "t", description: _("Go to today"), icon: "clock-arrow-down" %>
<% end %>

<% content_for :keyboard_shortcuts do %>
  <div>
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2"><%= _("Calendar") %></h3>
    <div class="shortcut-list">
      <%= render "shared/shortcut_row", key: "n", description: _("New event") %>
      <%= render "shared/shortcut_row", key: "t", description: _("Go to today") %>
      <%= render "shared/shortcut_row", key: mod_key("←"), description: _("Previous week") %>
      <%= render "shared/shortcut_row", key: mod_key("→"), description: _("Next week") %>
      <%= render "shared/shortcut_row", key: "← → ↑ ↓", description: _("Go from event to event") %>
      <%= render "shared/shortcut_row", key: "Enter", description: _("Open the event") %>
    </div>
  </div>
<% end %>
<% content_for :head do %>
  <meta name="turbo-refresh-method" content="morph">
  <meta name="turbo-refresh-scroll" content="preserve">
<% end %>

<div class="tool-layout calendar-layout"
     data-controller="calendar"
     data-action="arrow-keys:edge@window->calendar#pastTheWeek"
     data-calendar-tool-id-value="<%= @tool.id %>"
     data-calendar-week-start-value="<%= @week_start.iso8601 %>">

  <%
    week_end = @week_start + 6.days
    month_title = calendar_week_title(@week_start, week_end)
    is_current_week = @week_start == Date.current.beginning_of_week(:monday)
  %>
  <div class="tool-topbar flex-wrap gap-2">
    <!-- Left: Month and year -->
    <div class="flex-1 flex items-center gap-2">
      <h1 class="tool-topbar-title whitespace-nowrap"><%= month_title %></h1>
    </div>

    <!-- Center: Week navigation pill -->
    <%= render "components/nav_pill" do %>
      <%= render "components/nav_pill_button", icon: "chevron-left", title: _("Previous week (%{key})", key: mod_key("←")), data: { controller: "hotkey", action: "calendar#previousWeek", hotkey: "Mod+ArrowLeft" } %>
      <%= render "components/nav_pill_button", icon: "clock-arrow-down", title: _("Today (t)"), data: { controller: "hotkey", action: "calendar#goToToday", hotkey: "t" } %>
      <%= render "components/nav_pill_button", icon: "plus", title: _("New event (n)"), data: { controller: "hotkey", action: "calendar#newEvent", hotkey: "n" } %>
      <%= render "components/nav_pill_button", icon: "calendar-days", title: _("Pick a week"), data: { action: "calendar#openWeekPicker" } %>
      <%= render "components/nav_pill_button", icon: "chevron-right", title: _("Next week (%{key})", key: mod_key("→")), data: { controller: "hotkey", action: "calendar#nextWeek", hotkey: "Mod+ArrowRight" } %>
      <input type="date"
             aria-label="<%= _("Jump to the week of a date") %>"
             value="<%= @week_start.iso8601 %>"
             class="absolute opacity-0 pointer-events-none"
             data-action="change->calendar#jumpToWeek"
             data-calendar-target="weekInput">
    <% end %>

    <!-- Right: Sync status -->
    <div class="flex-1 flex items-center gap-3 justify-end">
      <% if @calendar_account && !@calendar_account.local? %>
        <div class="flex items-center gap-2"
             data-controller="sync-status"
             data-sync-status-url-value="<%= tool_calendar_sync_path(@tool) %>"
             data-sync-status-syncing-value="<%= @calendar_account.syncing? %>">
          <div class="w-1.5 h-1.5 rounded-full <%= @calendar_account.synced? ? 'bg-success' : (@calendar_account.sync_error? ? 'bg-error' : 'bg-warning') %>"
               aria-hidden="true"
               data-sync-status-target="indicator"></div>
          <span class="sr-only"><%= _("Calendar sync:") %></span>
          <%= tag.span class: "text-xs text-text-tertiary", role: "status", title: (@calendar_account.sync_error if @calendar_account.sync_error?), data: { sync_status_target: "status" } do %>
            <% if @calendar_account.syncing? %>
              <%= _("Syncing...") %>
            <% elsif @calendar_account.authentication_failed? %>
              <%= _("Login failed") %>
            <% elsif @calendar_account.last_synced_at %>
              <%= ago(@calendar_account.last_synced_at) %>
            <% else %>
              <%= _("Not synced") %>
            <% end %>
          <% end %>
          <%= render "components/icon_button",
              icon: "refresh-cw",
              title: _("Sync now"),
              size: :sm,
              href: tool_calendar_sync_path(@tool),
              method: :post,
              icon_class: @calendar_account.syncing? ? "animate-spin" : nil,
              data: { sync_status_target: "button", action: "click->sync-status#sync" } %>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Week grid -->
  <div class="tool-scroll-area calendar-week-container" id="calendar-week-container" data-calendar-target="grid" data-arrow-keys-target="scroller">
    <%= render "tools/calendars/week_grid",
        week_start: @week_start,
        events: @events,
        calendars: @calendars %>
  </div>

  <!-- New Event Modal -->
  <%
    # New events go to a calendar the server accepts them in, starting at the next hour for an hour
    writable_calendars = @calendars.reject(&:read_only?)
    default_calendar = writable_calendars.find(&:is_default?) || writable_calendars.first
    now = Time.current
    default_start = now.change(min: 0) + 1.hour
    default_end = default_start + 1.hour
    new_event = Calendars::Event.new(
      calendar: default_calendar,
      start_time: default_start,
      end_time: default_end
    ).tap(&:load_recurrence_for_form)
  %>
  <%= render "shared/modal", id: "new-event-modal", title: _("New Event"), size: :lg,
        data: { calendar_target: "newEventDialog" } do %>
    <div data-calendar-target="newEventModal">
      <%= render "tools/calendars/events/form",
          event: new_event,
          calendars: writable_calendars,
          tool: @tool,
          modal_id: "new-event-modal" %>
    </div>
  <% end %>

  <%= render "tools/calendars/event_dialog" %>
</div>
