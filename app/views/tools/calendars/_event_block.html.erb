<%#
  Event block displayed in the week grid
  Positioned absolutely based on start time and duration, in its column when it overlaps others
  For multi-day events, clips to the display_date boundaries
%>
<%
  # Get the display date (the day column we're rendering in)
  current_day = local_assigns[:display_date] || event.start_time.to_date
  day_start = current_day.beginning_of_day
  day_end = current_day.end_of_day

  # Clip event times to this day's boundaries
  visible_start = [event.start_time, day_start].max
  visible_end = [event.end_time, day_end].min

  # Calculate position and height based on visible portion
  start_hour = visible_start.hour
  start_minute = visible_start.min
  duration_minutes = ((visible_end - visible_start) / 60).to_i

  # Position from top (as percentage of 24 hours)
  top_position = (start_hour * 60 + start_minute) / (24.0 * 60) * 100

  # Height (as percentage of 24 hours); min-h-5 keeps short events readable
  height = duration_minutes / (24.0 * 60) * 100

  # Side by side with the events it overlaps
  column = local_assigns.fetch(:column, 0)
  columns = local_assigns.fetch(:columns, 1)
  left = column * 100.0 / columns
  width = 100.0 / columns

  # For multi-day events, show if this is the start day
  is_start_day = event.start_time.to_date == current_day
  show_time = is_start_day
  # Too short for the time and the title on lines of their own
  compact = duration_minutes < 45

%>

<div class="event-block-in absolute rounded-md shadow-sm cursor-pointer overflow-hidden border border-white/20 transition-all duration-150 hover:shadow-md hover:brightness-105 hover:z-10 min-h-5"
     style="top: <%= top_position %>%; height: <%= height %>%; left: calc(<%= left %>% + 2px); width: calc(<%= width %>% - 4px); <%= event_color_style(calendar) %>"
     data-event-id="<%= event.id %>"
     role="button"
     tabindex="0"
     aria-label="<%= event.summary %>, <%= format_datetime(event.start_time) %>"
     data-arrow-keys-target="item"
     data-action="click->calendar#showEvent">
  <div class="<%= compact ? 'px-1.5 py-0.5' : 'p-1.5' %> h-full overflow-hidden">
    <% if compact %>
      <div class="text-xs truncate">
        <% if show_time %><span class="text-[0.6875rem] font-medium"><%= format_time(event.start_time) %></span><% end %>
        <span class="font-semibold"><%= event.summary %></span>
      </div>
    <% else %>
      <% if show_time %>
        <div class="text-[0.6875rem] font-medium mb-0.5 truncate">
          <%= format_time(event.start_time) %>
        </div>
      <% end %>
      <div class="text-xs font-semibold truncate">
        <% if event.is_recurring? %><%= render "shared/icon", name: "repeat", size: 10, class: "inline-block mr-0.5 opacity-75" %><% end %><%= event.summary %>
      </div>
      <% if event.location.present? && is_start_day %>
        <div class="text-[0.625rem] mt-0.5 truncate opacity-90">
          <%= render "shared/icon", name: "map-pin", size: 10, class: "inline" %>
          <%= event.location %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
