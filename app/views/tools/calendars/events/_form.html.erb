<%#
  Shared form partial for creating and editing events
%>
<%
  is_new = event.new_record?
  form_url = is_new ? tool_calendar_events_path(tool) : tool_calendar_event_path(tool, event)
  form_method = is_new ? :post : :patch
  modal_id = local_assigns[:modal_id]
  # An all-day event shows from the start of its first day to the end of its last, wherever it was made
  all_day = event.all_day? && event.starts_at && event.ends_at
  # A weekly series repeats on the weekday it starts, unless other days are chosen
  weekly_days = Array(event.recurrence_days_of_week).presence ||
    (event.starts_at ? [ Calendars::Event::WDAY_TO_ABBR[event.first_day.wday] ] : [])
%>

<%# In the event details modal the form stays in its frame, so a failed save shows its errors there %>
<%# The fields' ids are this form's own: a calendar has the form for a new event on its
    page always, an open event's beside it, and another calendar can be on the page too
    (tiles in the workspace's own page) %>
<% ids = "calendar_#{tool.id}_#{event.persisted? ? event.id : "new"}" %>
<%= form_with model: event, url: form_url, method: form_method, namespace: ids,
      data: { controller: "recurrence-form", recurrence_form_frequency_value: event.recurrence_frequency || "none",
              recurrence_form_follow_start_value: event.rrule.blank? } do |f| %>
  <%= render "shared/error_flash", object: event %>

  <!-- Summary -->
  <div class="mb-4">
    <%= f.label :summary, class: "label" %>
    <%= f.text_field :summary,
      class: "input #{event.errors[:summary].any? ? 'input-error' : ''}",
      placeholder: _("Team meeting, Lunch with client..."),
      required: true,
      autofocus: true
    %>
  </div>

  <!-- Calendar Selection -->
  <div class="mb-4">
    <%= f.label :calendar_id, class: "label" %>
    <%= f.select :calendar_id,
      calendars.map { |c| [c.name, c.id] },
      {},
      class: "input",
      required: true
    %>
  </div>

  <!-- Date and Time -->
  <div class="mb-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= f.label :start_time, class: "label" %>
        <%= f.datetime_local_field :start_time,
          value: all_day ? event.first_day.beginning_of_day : event.start_time,
          class: "input",
          required: true,
          data: { calendar_target: "startTimeInput", action: "change->recurrence-form#startChanged" }
        %>
      </div>
      <div>
        <%= f.label :end_time, class: "label" %>
        <%= f.datetime_local_field :end_time,
          value: all_day ? event.last_day.end_of_day.change(sec: 0) : event.end_time,
          class: "input",
          required: true,
          data: { calendar_target: "endTimeInput" }
        %>
      </div>
    </div>
  </div>

  <!-- All Day Checkbox -->
  <div class="mb-4">
    <label class="flex items-center gap-3 cursor-pointer">
      <%= f.check_box :all_day, class: "w-4 h-4 rounded border-border text-accent focus:ring-accent/20" %>
      <span class="text-sm text-text-primary"><%= _("All day event") %></span>
    </label>
  </div>

  <!-- Recurrence -->
  <div class="mb-4">
    <label class="label"><%= _("Repeat") %></label>

    <%= f.select :recurrence_frequency,
      [[_("Does not repeat"), "none"], [_("Daily"), "daily"], [_("Weekly"), "weekly"],
       [_("Monthly"), "monthly"], [_("Yearly"), "yearly"]],
      {},
      class: "input",
      data: { action: "change->recurrence-form#frequencyChanged" }
    %>

    <div class="mt-3 space-y-3 <%= 'hidden' if event.recurrence_frequency.blank? || event.recurrence_frequency == 'none' %>"
         data-recurrence-form-target="optionsSection">

      <!-- Interval -->
      <div class="flex items-center gap-2">
        <span class="text-sm text-text-secondary"><%= _("Every") %></span>
        <%= f.number_field :recurrence_interval,
          "aria-label": _("Repeat every"),
          value: event.recurrence_interval || 1,
          min: 1, max: 99,
          class: "input w-20"
        %>
        <span class="text-sm text-text-secondary" data-recurrence-form-target="intervalUnit">
          <%= { "daily" => "day(s)", "weekly" => "week(s)", "monthly" => "month(s)", "yearly" => "year(s)" }[event.recurrence_frequency] %>
        </span>
      </div>

      <!-- Weekly: Day of week checkboxes -->
      <div data-recurrence-form-target="weeklyOptions"
           class="<%= 'hidden' unless event.recurrence_frequency == 'weekly' %>">
        <span class="text-sm text-text-secondary mb-1.5 block"><%= _("On days") %></span>
        <div class="flex gap-1">
          <% [["MO", "M"], ["TU", "T"], ["WE", "W"], ["TH", "T"], ["FR", "F"], ["SA", "S"], ["SU", "S"]].each do |abbr, letter| %>
            <% checked = weekly_days.include?(abbr) %>
            <label class="flex items-center justify-center w-9 h-9 rounded-full border cursor-pointer text-sm font-medium transition-colors
                          <%= checked ? 'bg-accent-solid text-text-inverse border-accent-solid' : 'border-border text-text-secondary hover:border-accent/50' %>">
              <%= check_box_tag "calendars_event[recurrence_days_of_week][]", abbr, checked,
                    class: "sr-only",
                    id: "#{ids}_recurrence_day_#{abbr}",
                    data: { recurrence_form_target: "day", action: "change->recurrence-form#toggleDayButton" } %>
              <%= letter %>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Monthly: By day of month or by weekday -->
      <%
        week_num = event.starts_at ? ((event.first_day.day - 1) / 7) + 1 : 1
        ordinals = { 1 => _("1st"), 2 => _("2nd"), 3 => _("3rd"), 4 => _("4th"), 5 => _("5th") }
        wday_name = event.starts_at ? format_weekday(event.first_day) : _("day")
        monthly_dow_label = _("The %{ordinal} %{weekday}", ordinal: ordinals[week_num] || week_num, weekday: wday_name)
      %>
      <div data-recurrence-form-target="monthlyOptions"
           class="<%= 'hidden' unless event.recurrence_frequency == 'monthly' %>">
        <span class="text-sm text-text-secondary mb-1.5 block"><%= _("Repeat by") %></span>
        <div class="space-y-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :recurrence_monthly_by, "day_of_month",
              class: "w-4 h-4 text-accent focus:ring-accent/20" %>
            <span class="text-sm text-text-primary"><%= _("Day of the month") %></span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :recurrence_monthly_by, "day_of_week",
              class: "w-4 h-4 text-accent focus:ring-accent/20" %>
            <span class="text-sm text-text-primary" data-recurrence-form-target="weekdayLabel"><%= monthly_dow_label %></span>
          </label>
        </div>
      </div>

      <!-- End condition -->
      <div>
        <span class="text-sm text-text-secondary mb-1.5 block"><%= _("Ends") %></span>
        <div class="space-y-2">
          <label class="flex items-center gap-2 cursor-pointer">
            <%= f.radio_button :recurrence_end_type, "never",
              class: "w-4 h-4 text-accent focus:ring-accent/20",
              data: { action: "change->recurrence-form#endTypeChanged" } %>
            <span class="text-sm text-text-primary"><%= _("Never") %></span>
          </label>

          <div class="flex items-center gap-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.radio_button :recurrence_end_type, "count",
                class: "w-4 h-4 text-accent focus:ring-accent/20",
                data: { action: "change->recurrence-form#endTypeChanged" } %>
              <span class="text-sm text-text-primary"><%= _("After") %></span>
            </label>
            <div data-recurrence-form-target="endCountField"
                 class="flex items-center gap-1 <%= 'hidden' unless event.recurrence_end_type == 'count' %>">
              <%= f.number_field :recurrence_count,
                "aria-label": _("Number of repeats"),
                value: event.recurrence_count || 10,
                min: 1, max: 999,
                class: "input w-20" %>
              <span class="text-sm text-text-secondary">times</span>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.radio_button :recurrence_end_type, "until",
                class: "w-4 h-4 text-accent focus:ring-accent/20",
                data: { action: "change->recurrence-form#endTypeChanged" } %>
              <span class="text-sm text-text-primary"><%= _("On date") %></span>
            </label>
            <div data-recurrence-form-target="endUntilField"
                 class="<%= 'hidden' unless event.recurrence_end_type == 'until' %>">
              <%= f.date_field :recurrence_until,
                "aria-label": _("Repeat until date"),
                value: event.recurrence_until,
                class: "input" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Alerts: a select per alert, and one more to add one. The calendar's server keeps them and
       the calendar app on a phone or computer gives them (Calendars::Reminder) -->
  <div class="mb-4">
    <span class="label" id="<%= ids %>_reminders_label"><%= _("Alerts") %></span>
    <%= hidden_field_tag "calendars_event[reminders][]", "", id: nil %>
    <div class="space-y-2">
      <% (event.reminders + [ nil ]).each_with_index do |minutes, index| %>
        <%= select_tag "calendars_event[reminders][]",
          options_for_select(reminder_options(event, minutes), minutes.nil? ? "" : minutes.to_s),
          id: "#{ids}_reminder_#{index}", class: "input", "aria-labelledby": "#{ids}_reminders_label" %>
      <% end %>
    </div>
    <p class="text-xs text-text-tertiary mt-1"><%= _("The calendar app on your phone or computer gives the alert.") %></p>
  </div>

  <!-- Location -->
  <div class="mb-4">
    <%= f.label :location, class: "label" %>
    <%= f.text_field :location,
      class: "input",
      placeholder: _("Meeting room, address...")
    %>
  </div>

  <!-- Description -->
  <div class="mb-4">
    <%= f.label :description, class: "label" %>
    <%= f.text_area :description,
      class: "input",
      rows: 4,
      placeholder: _("Add notes, agenda items...")
    %>
  </div>

  <!-- Form Actions -->
  <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-border-light">
    <% if modal_id %>
      <%= render "components/button",
          text: _("Cancel"),
          variant: :secondary,
          type: :button,
          data: { action: "click->modal#close" } %>
    <% else %>
      <%= render "components/button",
          text: _("Cancel"),
          variant: :secondary,
          href: tool_calendar_path(tool),
          data: { turbo_frame: "_top" } %>
    <% end %>
    <%= render "components/button",
        text: is_new ? _("Create Event") : _("Save Changes"),
        icon: "calendar" %>
  </div>
<% end %>
