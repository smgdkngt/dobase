<%#
  One comment in a card's discussion.

  Locals:
    comment — Boards::Comment
    card    — the card it belongs to
    tool    — the board tool, for the delete path and the ownership check
%>
<%= render "shared/comment", comment: comment, frame: "card-detail-content",
      delete_path: (tool_board_card_comment_path(tool, card, comment) if comment.user_id == current_user.id || tool.owned_by?(current_user)) %>
