        <%# Discussion / Comments %>
        <section class="border-t border-border-light p-4 sm:p-5">
          <h3 class="text-sm font-semibold text-text-tertiary mb-4 flex items-center gap-1.5">
            <%= render "shared/icon", name: "message-square-text", size: 14, class: "opacity-70" %>
            <%= _("Comments") %>
            <% if card.comments.any? %>
              <span class="ms-0.5 font-normal normal-case tracking-normal"><%= card.comments.count %></span>
            <% end %>
          </h3>

          <%= render "shared/comment_list",
                comments: card.comments.includes(:user, :rich_text_body).order(created_at: :asc).to_a,
                partial: "tools/boards/cards/comment",
                locals: { card: card, tool: tool } %>

          <%# Comment form at the bottom %>
          <%# Someone else writing here right now; filled in by presence_controller.js %>
          <p class="presence-typing" hidden aria-live="polite" data-presence-target="typing" data-presence-for="card:<%= card.id %>"></p>
          <%= form_with url: tool_board_card_comments_path(tool, card), data: { turbo_frame: "card-detail-content" } do %>
            <div class="flex gap-2.5">
              <%= render "shared/avatar", user: current_user, size: :sm %>
              <div class="flex-1" data-action="keydown->presence#typing" data-presence-context-param="card:<%= card.id %>">
                <%= render "components/rich_text_input", name: "body", placeholder: _("Write a comment..."), draft: "card-#{card.id}-comment", mentions: @collaborators.where.not(id: current_user.id) do %>
                  <%= render "components/icon_button",
                        icon: "send",
                        title: _("Post comment"),
                        variant: :accent,
                        size: :sm,
                        class: "rounded",
                        type: :submit %>
                <% end %>
              </div>
            </div>
          <% end %>
        </section>

      </div>
    </div>
