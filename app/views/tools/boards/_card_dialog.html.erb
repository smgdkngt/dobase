<%# The dialog a card's details open in. Empty until the board fetches the card that
    is opened (board#openCard). %>
<dialog id="card-detail-modal"
        aria-label="Card details"
        class="modal-dialog"
        style="max-width: 56rem;"
        data-controller="modal"
        data-board-target="cardDetailDialog">
  <div data-board-target="cardModal"></div>
</dialog>
