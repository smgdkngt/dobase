<% content_for(:title) { "#{@tool.name} - #{app_name}" } %>

<% content_for :command_palette_actions do %>
  <%= render "shared/command_palette_action", key: "m", description: "Toggle microphone", icon: "mic" %>
  <%= render "shared/command_palette_action", key: "v", description: "Toggle camera", icon: "video" %>
  <%= render "shared/command_palette_action", key: "s", description: "Toggle screen share", icon: "monitor" %>
<% end %>

<% content_for :keyboard_shortcuts do %>
  <div>
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Room</h3>
    <div class="shortcut-list">
      <%= render "shared/shortcut_row", key: "m", description: "Toggle microphone" %>
      <%= render "shared/shortcut_row", key: "v", description: "Toggle camera" %>
      <%= render "shared/shortcut_row", key: "s", description: "Toggle screen share" %>
    </div>
  </div>
<% end %>

<div class="tool-layout tool-layout-anchored room-layout"
     data-controller="room"
     data-room-token-url-value="<%= tool_room_tokens_path(@tool) %>"
     data-room-activity-url-value="<%= tool_room_activity_path(@tool) %>"
     data-room-user-name-value="<%= current_user.name %>"
     data-room-tool-path-value="<%= tool_room_path(@tool) %>"
     data-room-tool-id-value="<%= @tool.id %>"
     data-persistent-room-placeholder>

  <%# Hidden hotkey triggers — active call-wide, since this element (and these
      buttons with it) moves into the turbo-permanent PiP container on join %>
  <button data-controller="hotkey" data-hotkey="m" data-action="click->room#toggleMic" hidden>Toggle microphone</button>
  <button data-controller="hotkey" data-hotkey="v" data-action="click->room#toggleCamera" hidden>Toggle camera</button>
  <button data-controller="hotkey" data-hotkey="s" data-action="click->room#toggleScreen" hidden>Toggle screen share</button>

  <div class="tool-topbar" data-action="pointerdown->room#startDrag">
    <div class="flex items-center gap-2">
      <h1 class="tool-topbar-title"><%= @tool.name %></h1>
    </div>
    <div class="tool-topbar-actions">
      <button type="button"
              class="room-participant-count-btn"
              popovertarget="room-participant-list"
              style="anchor-name: --room-participants-btn"
              aria-label="Participants in this call">
        <%= render "shared/icon", name: "users", size: 14, class: "text-text-tertiary" %>
        <span data-room-target="participantCount">0 participants</span>
      </button>

      <div id="room-participant-list"
           popover="auto"
           class="popover-menu w-64 p-0 m-0 inset-auto"
           style="position-anchor: --room-participants-btn; position-area: block-end span-inline-end">
        <div class="text-xs font-semibold text-text-tertiary uppercase tracking-wider px-4 pt-3 pb-2">In this call</div>
        <div class="max-h-64 overflow-y-auto pb-2" data-room-target="participantListBody"></div>
      </div>
    </div>
    <span class="pip-grip-handle"><%= render "shared/icon", name: "grip-vertical", size: 14 %></span>
  </div>

  <%# In another call state (shown via CSS when PiP is active) %>
  <div class="room-in-another-call">
    <%= render "components/empty_state",
          title: "You're already in a call",
          description: "Leave your current call before joining another room.",
          icon: "video-off",
          size: :md %>
  </div>

  <%# Pre-join state %>
  <div class="room-pre-join" data-room-target="preJoin">
    <div class="hidden flex flex-col items-center gap-2 w-80 max-w-full" data-room-target="preJoinError">
      <div class="flash flash-alert w-full">
        <%= render "shared/icon", name: "alert-circle", size: 18 %>
        <span class="flex-1" data-room-target="preJoinErrorMessage"></span>
      </div>
      <%= render "components/button",
            text: "Try again",
            variant: :secondary,
            size: :sm,
            icon: "refresh-cw",
            type: :button,
            data: { action: "click->room#retryAfterError" } %>
    </div>

    <%# Camera preview %>
    <div class="w-80 max-w-full rounded-xl overflow-hidden bg-background-secondary shadow-md">
      <video class="w-full aspect-video object-cover object-center bg-background-secondary"
             data-room-target="previewVideo"
             autoplay playsinline muted></video>
    </div>

    <%# Device selectors %>
    <div class="w-80 max-w-full flex flex-col gap-3">
      <div class="form-field">
        <label class="label" for="room-audio-device">
          <%= render "shared/icon", name: "mic", size: 14, class: "inline-block align-[-2px] mr-1 text-text-tertiary" %>
          Microphone
        </label>
        <select id="room-audio-device" class="input" data-room-target="audioSelect"></select>
      </div>

      <div class="form-field">
        <label class="label" for="room-video-device">
          <%= render "shared/icon", name: "video", size: 14, class: "inline-block align-[-2px] mr-1 text-text-tertiary" %>
          Camera
        </label>
        <select id="room-video-device" class="input"
                data-room-target="videoSelect"
                data-action="change->room#changePreviewCamera"></select>
      </div>
    </div>

    <%= render "components/button",
          text: "Join Room",
          variant: :primary,
          icon: "video",
          type: :button,
          data: { action: "click->room#join", room_target: "joinButton" } %>
  </div>

  <%# In-call state %>
  <div class="room-in-call hidden" data-room-target="inCall">
    <%# Content area (relative wrapper for local video overlay, spotlight, banners) %>
    <div class="room-content-area" data-room-target="contentArea">
      <div class="room-banner hidden" data-room-target="reconnectingBanner">
        <div class="flash flash-warning">
          <%= render "shared/icon", name: "loader-2", size: 16, class: "animate-spin" %>
          <span>Reconnecting…</span>
        </div>
      </div>

      <%# Screen share spotlight — takes over the content area while active %>
      <div class="room-spotlight hidden" data-room-target="spotlight">
        <video autoplay playsinline data-room-target="spotlightVideo"></video>
        <div class="room-tile-overlay">
          <span class="text-xs font-medium text-white" data-room-target="spotlightLabel"></span>
        </div>
      </div>

      <%# Video grid (remote participants) %>
      <div class="room-video-grid hidden" data-room-target="videoGrid"></div>

      <%# Empty state (alone in call) %>
      <div class="h-full flex items-center justify-center" data-room-target="emptyState">
        <%= render "components/empty_state",
              title: "Waiting for others to join",
              description: "You're the only one here right now.",
              icon: "users",
              size: :md %>
      </div>

      <%# Local camera PiP %>
      <div class="room-local-video" data-room-target="localVideo">
        <video class="room-local-video-feed" autoplay playsinline muted></video>
        <div class="room-tile-overlay">
          <span class="hidden room-quality-dot" data-room-target="localQualityDot"></span>
          <span class="text-xs font-medium text-white">You</span>
          <span class="hidden text-white/80" data-room-target="localMutedIcon">
            <%= render "shared/icon", name: "mic-off", size: 12 %>
          </span>
        </div>
      </div>
    </div>

    <%# Controls bar %>
    <div class="room-controls">
      <%= render "components/icon_button",
            icon: "mic",
            title: "Mute microphone",
            data: {
              room_target: "micButton",
              action: "click->room#toggleMic"
            } %>

      <%= render "components/icon_button",
            icon: "video",
            title: "Turn off camera",
            data: {
              room_target: "cameraButton",
              action: "click->room#toggleCamera"
            } %>

      <%= render "components/icon_button",
            icon: "monitor",
            title: "Share screen",
            data: {
              room_target: "screenButton",
              action: "click->room#toggleScreen"
            } %>

      <button type="button"
              class="icon-btn"
              title="Device settings"
              popovertarget="room-device-settings"
              style="anchor-name: --room-settings-btn">
        <%= render "shared/icon", name: "settings", size: 16 %>
      </button>

      <%# Device settings popover %>
      <div id="room-device-settings"
           popover="auto"
           class="popover-menu w-72 p-4 m-0 inset-auto"
           style="position-anchor: --room-settings-btn; position-area: block-start span-inline-end">
        <div class="text-xs font-semibold text-text-tertiary uppercase tracking-wider mb-3">Device Settings</div>
        <div class="flex flex-col gap-3">
          <div class="form-field">
            <label class="label" for="room-settings-audio">Microphone</label>
            <select id="room-settings-audio" class="input"
                    data-room-target="settingsAudioSelect"
                    data-action="change->room#switchAudioDevice"></select>
          </div>
          <div class="form-field">
            <label class="label" for="room-settings-video">Camera</label>
            <select id="room-settings-video" class="input"
                    data-room-target="settingsVideoSelect"
                    data-action="change->room#switchVideoDevice"></select>
          </div>
        </div>
      </div>

      <%= render "components/button",
            text: "Leave",
            variant: :danger,
            icon: "log-out",
            type: :button,
            data: { action: "click->room#leave" } %>
    </div>
  </div>

  <%# Participant tile template %>
  <template data-room-target="participantTemplate">
    <div class="relative bg-background-secondary rounded-xl overflow-hidden" data-participant-id="">
      <video class="hidden w-full h-full object-cover object-center" data-video autoplay playsinline muted></video>
      <div class="absolute inset-0 flex flex-col items-center justify-center gap-3" data-placeholder>
        <div class="w-16 h-16 rounded-full bg-background-tertiary flex items-center justify-center text-xl font-semibold text-text-primary" data-initials></div>
        <span class="text-sm text-text-secondary" data-name></span>
      </div>
      <div class="room-tile-overlay">
        <span class="hidden room-quality-dot" data-quality-dot></span>
        <span class="text-xs font-medium text-white truncate" data-name></span>
        <span class="hidden text-white/80" data-muted-icon>
          <%= render "shared/icon", name: "mic-off", size: 12 %>
        </span>
      </div>
    </div>
  </template>

</div>
