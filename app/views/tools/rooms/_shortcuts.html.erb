<% content_for :command_palette_actions do %>
  <%= render "shared/command_palette_action", key: "m", description: _("Toggle microphone"), icon: "mic" %>
  <%= render "shared/command_palette_action", key: "v", description: _("Toggle camera"), icon: "video" %>
  <%= render "shared/command_palette_action", key: "s", description: _("Toggle screen share"), icon: "monitor" %>
<% end %>

<% content_for :keyboard_shortcuts do %>
  <div>
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2"><%= _("Room") %></h3>
    <div class="shortcut-list">
      <%= render "shared/shortcut_row", key: "m", description: _("Toggle microphone") %>
      <%= render "shared/shortcut_row", key: "v", description: _("Toggle camera") %>
      <%= render "shared/shortcut_row", key: "s", description: _("Toggle screen share") %>
    </div>
  </div>
<% end %>
