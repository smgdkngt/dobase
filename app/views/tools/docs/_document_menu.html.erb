<%# What a right click on a document in the list offers. Locals: document %>
<% tool = document.tool %>
<%= render "components/context_menu", label: _("Document: %{title}", title: document.title) do %>
  <%= render "components/menu_item", text: _("Open"), icon: "eye", href: tool_docs_document_path(tool, document) %>
  <%= render "components/menu_item", text: _("Edit"), icon: "edit", href: edit_tool_docs_document_path(tool, document) %>
  <%= render "components/menu_divider" %>
  <%= render "components/menu_item", text: _("Copy link"), icon: "link", data: { copy: tool_docs_document_url(tool, document) } %>
  <%= render "components/menu_item", text: _("Delete"), icon: "trash-2", variant: :danger, href: tool_docs_document_path(tool, document), method: :delete,
        turbo_confirm: _("Delete “%{title}”?", title: document.title), data: { turbo_confirm_button: _("Delete"), turbo_frame: "_top", sound: "trash" } %>
<% end %>
