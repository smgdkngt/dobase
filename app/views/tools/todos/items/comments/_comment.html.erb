<%#
  One comment in a todo item's discussion.

  Locals:
    comment — Todos::Comment
    item    — the todo item it belongs to
    tool    — the todos tool, for the delete path and the ownership check
%>
<%= render "shared/comment", comment: comment, frame: "item-detail-content",
      delete_path: (tool_todo_item_comment_path(tool, item, comment) if comment.user_id == current_user.id || tool.owned_by?(current_user)) %>
