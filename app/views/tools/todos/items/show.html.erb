<%= turbo_frame_tag "item-detail-content", class: "contents" do %>
<div data-controller="todo-item"
     data-todo-item-item-id-value="<%= @item.id %>"
     data-todo-item-tool-id-value="<%= @tool.id %>"
     class="flex flex-col w-full"
     style="max-height: 80vh; min-height: 60vh;">

  <%= render "tools/todos/items/header", item: @item, tool: @tool %>

  <%# ─── Body: two-column layout ────────────────────────────────────── %>
  <div class="detail-modal-body">

    <%# Left column: Description + Activity %>
    <div class="detail-modal-main">
      <div>

        <%= render "tools/todos/items/description", item: @item, tool: @tool %>
        <%= render "tools/todos/items/comments", item: @item, tool: @tool %>
      </div>
    </div>

    <%# Right column: Metadata sidebar %>
    <div class="detail-modal-aside">
      <div>

        <%= render "tools/todos/items/assignee", item: @item, tool: @tool %>
        <%= render "tools/todos/items/attachments", item: @item, tool: @tool %>
        <%= render "tools/todos/items/due_date", item: @item, tool: @tool %>
        <%= render "tools/todos/items/repeats", item: @item, tool: @tool %>
    </div>
  </div>

  <%# ─── Footer ──────────────────────────────────────────────────────── %>
  <div class="flex items-center justify-between px-4 sm:px-5 py-3 border-t border-border-light bg-background-secondary/50">
    <div class="flex items-center gap-4">
      <%= link_to tool_todo_item_path(@tool, @item),
          class: "inline-flex items-center gap-1.5 text-sm text-text-tertiary hover:text-error transition-colors",
          data: {
            turbo_method: :delete,
            turbo_confirm: "Delete this item? This cannot be undone.",
            turbo_confirm_button: "Delete",
            turbo_frame: "_top"
          } do %>
        <%= render "shared/icon", name: "trash-2", size: 14 %>
        Delete item
      <% end %>
    </div>
    <% if (text = attribution_text(@item)) %>
      <span class="text-xs text-text-tertiary"><%= text %></span>
    <% end %>
  </div>

</div>
<% end %>
