<% content_for(:title) { "#{@tool.name} - #{app_name}" } %>
<% reorder_mode = params[:reorder].present? %>

<% content_for :command_palette_actions do %>
  <%= render "shared/command_palette_action", key: "t", description: _("Add todo"), icon: "plus" %>
  <%= render "shared/command_palette_action", key: "n", description: _("Add list"), icon: "list" %>
<% end %>

<% content_for :keyboard_shortcuts do %>
  <div>
    <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2"><%= _("Todos") %></h3>
    <div class="shortcut-list">
      <%= render "shared/shortcut_row", key: "t", description: _("Add todo") %>
      <%= render "shared/shortcut_row", key: "n", description: _("Add list") %>
      <%= render "shared/shortcut_row", key: "↑ ↓", description: _("Go from todo to todo") %>
      <%= render "shared/shortcut_row", key: "Enter", description: _("Open the todo") %>
      <%= render "shared/shortcut_row", key: "Space", description: _("Tick the todo off") %>
      <%= render "shared/shortcut_row", key: "←", description: _("Go to its checkbox") %>
      <%= render "shared/shortcut_row", key: "Shift+↑ ↓", description: _("Move the todo") %>
    </div>
  </div>
<% end %>

<div class="tool-layout flex flex-col h-screen overflow-hidden" data-controller="todo" data-todo-tool-id-value="<%= @tool.id %>">
  <button data-controller="hotkey" data-hotkey="t" data-action="click->todo#addItemToFirstList" hidden><%= _("Add todo") %></button>
  <%= render "components/tool_topbar", title: @tool.name do %>
    <% if reorder_mode %>
      <%= render "components/button", text: _("Done"), size: :sm, variant: :primary, href: tool_todo_path(@tool), data: { turbo_action: "replace" } %>
    <% else %>
      <%= render "components/button", text: _("Edit"), size: :sm, variant: :ghost, href: tool_todo_path(@tool, reorder: 1) %>
    <% end %>
    <%= render "components/button", text: _("Add List"), icon: "plus", size: :sm, variant: :secondary, type: :button, commandfor: "add-list-modal-#{@tool.id}", command: "show-modal", data: { controller: "hotkey", hotkey: "n" } %>
  <% end %>

  <div class="tool-scroll-area flex-1 overflow-y-auto p-4 pt-6">
    <% if @lists.empty? %>
      <div class="flex items-center justify-center h-full">
        <%= render "components/empty_state",
            icon: "check-square",
            title: _("Nothing to do yet"),
            description: _("Create a list to start organizing your work"),
            size: :md %>
      </div>
    <% else %>
      <div class="max-w-4xl mx-auto">
        <% unless reorder_mode %>
          <div class="pb-3">
            <%= render "tools/assignee_filter", collaborators: @collaborators, current: @assignee_filter %>
          </div>
        <% end %>

        <div class="flex flex-col gap-4 <%= 'reorder-mode' if reorder_mode %>"
             <% if reorder_mode %>
             data-controller="sortable"
             data-sortable-url-value="<%= tool_todo_positions_path(@tool) %>"
             data-sortable-param-name-value="list_ids"
             <% end %>>
          <%= render partial: "tools/todos/list",
                collection: @lists, as: :list,
                locals: { tool: @tool, lists: @lists, reorder_mode: reorder_mode, assignee_filter: @assignee_filter } %>
        </div>
      </div>
    <% end %>
  </div>

  <%= render "tools/todos/item_dialog" %>

  <%# Add list dialog %>
  <%= render "shared/modal", id: "add-list-modal-#{@tool.id}", title: _("Add List"), size: :sm do %>
    <%= form_with url: tool_todo_lists_path(@tool), method: :post, data: { turbo_frame: "_top" } do %>
      <%= render "components/form_field", label: _("List title"), name: "title", required: true, autofocus: true, placeholder: _("e.g. To Do") %>
      <div class="flex justify-end gap-2 mt-4">
        <%= render "components/button", text: _("Cancel"), variant: :ghost, type: :button, data: { action: "modal#close" } %>
        <%= render "components/button", text: _("Add List"), variant: :primary %>
      </div>
    <% end %>
  <% end %>
</div>
