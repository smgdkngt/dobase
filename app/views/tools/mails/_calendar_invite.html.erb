<%#
  Calendar Invite Card Component

  Required:
    invite: Calendars::Invite object

  Shows:
    - Meeting details (summary, date/time, duration, location)
    - Organizer information
    - Status badge (pending/accepted/declined)
    - For pending invites, a form to add it to one of the user's writable calendars, or decline it
%>
<div class="border border-accent/20 rounded-lg bg-accent/5 overflow-hidden">
  <!-- Header -->
  <div class="px-4 py-3 bg-accent/10 border-b border-accent/20 flex items-center gap-3">
    <%= render "shared/icon", name: "calendar", size: 20, class: "text-accent" %>
    <div class="flex-1">
      <h3 class="font-medium text-text-primary">Calendar Invitation</h3>
    </div>
    <% if invite.accepted? %>
      <%= render "components/badge", text: "Accepted", variant: :success %>
    <% elsif invite.declined? %>
      <%= render "components/badge", text: "Declined", variant: :muted %>
    <% elsif invite.pending? %>
      <%= render "components/badge", text: "Pending", variant: :warning %>
    <% elsif invite.cancelled? %>
      <%= render "components/badge", text: "Cancelled", variant: :error %>
    <% end %>
  </div>

  <!-- Meeting Details -->
  <div class="px-4 py-4 space-y-3">
    <!-- Title -->
    <div>
      <h4 class="text-lg font-semibold text-text-primary">
        <%= invite.summary.presence || "(No title)" %>
      </h4>
    </div>

    <!-- Date & Time -->
    <% if invite.starts_at && invite.ends_at %>
      <div class="flex items-start gap-2 text-sm">
        <%= render "shared/icon", name: "clock", size: 16, class: "text-text-secondary mt-0.5" %>
        <div class="text-text-primary">
          <% if invite.all_day? %>
            <p>
              <%= invite.starts_at.strftime("%A, %B %-d, %Y") %>
              <% if invite.last_day > invite.starts_at.to_date %>
                - <%= invite.last_day.strftime("%A, %B %-d, %Y") %>
              <% end %>
            </p>
            <p class="text-text-secondary">All day</p>
          <% else %>
            <p><%= invite.starts_at.strftime("%A, %B %-d, %Y") %></p>
            <p class="text-text-secondary">
              <%= format_time(invite.starts_at) %> - <%= format_time(invite.ends_at) %>
              <% if invite.duration_display %>
                (<%= invite.duration_display %>)
              <% end %>
            </p>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Location -->
    <% if invite.location.present? %>
      <div class="flex items-start gap-2 text-sm">
        <%= render "shared/icon", name: "map-pin", size: 16, class: "text-text-secondary mt-0.5" %>
        <div class="text-text-primary">
          <%= invite.location %>
        </div>
      </div>
    <% end %>

    <!-- Organizer -->
    <% if invite.organizer_name.present? || invite.organizer_email.present? %>
      <div class="flex items-start gap-2 text-sm">
        <%= render "shared/icon", name: "user", size: 16, class: "text-text-secondary mt-0.5" %>
        <div class="text-text-primary">
          <% if invite.organizer_name.present? %>
            <span class="font-medium"><%= invite.organizer_name %></span>
            <% if invite.organizer_email.present? %>
              <span class="text-text-secondary">(<%= invite.organizer_email %>)</span>
            <% end %>
          <% else %>
            <%= invite.organizer_email %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Description -->
    <% if invite.description.present? %>
      <div class="pt-2 border-t border-border-light">
        <p class="text-sm text-text-secondary whitespace-pre-wrap"><%= invite.description %></p>
      </div>
    <% end %>
  </div>

  <!-- Actions for Pending Invites -->
  <% if invite.pending? %>
    <% if invite_target_calendars.any? %>
      <div class="px-4 py-3 bg-background-secondary border-t border-border-light">
        <%
          default_calendar = invite_target_calendars.find(&:is_default?) || invite_target_calendars.first
          default_calendar_tool = default_calendar.account.tool

          # Build a mapping of calendar_id => tool_id for the form action switcher
          calendar_to_tool_map = invite_target_calendars.to_h { |calendar| [ calendar.id, calendar.account.tool_id ] }
        %>
        <%= form_with url: tool_calendar_invites_path(default_calendar_tool),
                      method: :post,
                      class: "space-y-3",
                      data: {
                        controller: "calendar-invite-form",
                        calendar_invite_form_calendar_map_value: calendar_to_tool_map.to_json,
                        calendar_invite_form_invite_id_value: invite.id
                      } do |f| %>
          <%= f.hidden_field :invite_id, value: invite.id, id: nil %>

          <!-- Calendar Selection (if multiple calendars) -->
          <% if invite_target_calendars.many? %>
            <%= render "components/form_field",
                label: "Add to calendar",
                name: "calendar_id",
                id: "invite_#{invite.id}_calendar_id",
                type: :select,
                options: invite_target_calendars.map { |calendar| [ "#{calendar.account.tool.name} - #{calendar.name}", calendar.id ] },
                value: default_calendar.id,
                data: { calendar_invite_form_target: "calendarSelect", action: "change->calendar-invite-form#updateFormAction" } %>
          <% else %>
            <%= f.hidden_field :calendar_id, value: default_calendar.id, id: nil %>
            <div class="text-sm text-text-secondary">
              Will be added to: <span class="font-medium text-text-primary"><%= default_calendar_tool.name %> - <%= default_calendar.name %></span>
            </div>
          <% end %>

          <!-- Action Buttons -->
          <div class="flex items-center gap-2">
            <%= render "components/button",
                text: "Add to Calendar",
                icon: "calendar-plus",
                variant: :primary,
                size: :sm,
                type: :submit %>
            <%= render "components/button",
                text: "Decline",
                variant: :secondary,
                size: :sm,
                href: tool_calendar_invite_path(default_calendar_tool, invite),
                method: :delete,
                data: { turbo_confirm: "Decline this invitation?", turbo_confirm_button: "Decline" } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <%# Declining goes through a calendar tool too, so without one there is nothing to offer %>
      <div class="px-4 py-3 bg-background-secondary border-t border-border-light">
        <p class="text-sm text-text-secondary">
          No calendar configured. Set up a calendar tool to accept this invitation.
        </p>
      </div>
    <% end %>
  <% elsif invite.cancelled? %>
    <div class="px-4 py-3 bg-background-secondary border-t border-border-light flex flex-wrap items-center gap-3">
      <p class="text-sm text-text-secondary">This event has been cancelled.</p>
      <% if (accepted = invite.method == "CANCEL" && invite.accepted_invitation) && (calendar_tool = accepted.added_to_calendar&.account&.tool) %>
        <p class="text-sm text-text-secondary">It's still in your calendar.</p>
        <%= render "components/button",
            text: "View in Calendar",
            icon: "external-link",
            variant: :secondary,
            size: :sm,
            href: tool_calendar_path(calendar_tool, week_start: accepted.starts_at&.to_date) %>
      <% end %>
    </div>
  <% elsif invite.accepted? && invite.created_event_id && (calendar_tool = invite.added_to_calendar&.account&.tool) %>
    <!-- Link to the event's week in the calendar -->
    <div class="px-4 py-3 bg-background-secondary border-t border-border-light">
      <%= render "components/button",
          text: "View in Calendar",
          icon: "external-link",
          variant: :secondary,
          size: :sm,
          href: tool_calendar_path(calendar_tool, week_start: invite.starts_at&.to_date) %>
    </div>
  <% end %>
</div>
