<%# Locals: message, trust_actions (true: the buttons that trust a sender with images are forms
    of their own, so a page that shows a mail inside a form says false) %>
<% if message.body_html.present? %>
  <%
    # Only the attributes Mails::ReadableHtml allows are left: no event handlers
    sanitized = Mails::ReadableHtml.from(message)

    # Strip remote images: replace src with blank, track if any were found
    has_remote_images = sanitized.match?(/<img\b[^>]*?\bsrc\s*=\s*["']https?:\/\//i) || sanitized.match?(/url\(\s*["']?\s*https?:/i) ||
      sanitized.match?(/\bbackground\s*=\s*["']?\s*https?:/i)
    images_stripped = sanitized.gsub(/(<img\b[^>]*?)\bsrc\s*=\s*["']https?:\/\/[^"']*["']/i, '\1data-blocked-src=""')

    safe_srcdoc = mail_frame_document(images_stripped)
    full_srcdoc = mail_frame_document(sanitized, remote_content: true)
    images_trusted = has_remote_images && message.account.shows_images_from?(message.from_address)
    can_trust_sender = local_assigns.fetch(:trust_actions, true) && message.from_address.present? && !message.from_address.casecmp?(message.account.email_address)
  %>
  <div data-controller="email-frame"
       data-email-frame-full-srcdoc-value="<%= full_srcdoc %>">
    <% if images_trusted %>
      <% if can_trust_sender %>
        <%# Nothing to decide here any more: a quiet line, not a box above every mail of theirs %>
        <div class="email-images-note email-images-note-quiet" title="Images from <%= message.from_address %> are always shown">
          <%= render "shared/icon", name: "image", size: 12, class: "shrink-0" %>
          <span>Images shown for this sender.</span>
          <%= button_to "Stop", tool_mail_trusted_sender_path(message.account.tool, message), method: :delete,
                class: "email-images-action", form_class: "contents",
                aria: { label: "Stop showing images from #{message.from_address}" } %>
        </div>
      <% end %>
    <% elsif has_remote_images %>
      <div class="email-images-note" data-email-frame-target="banner">
        <%= render "shared/icon", name: "image", size: 14, class: "text-text-tertiary shrink-0" %>
        <span title="Images are hidden to protect your privacy">Images are hidden.</span>
        <button type="button" class="email-images-action" data-action="email-frame#showImages">Show images</button>
        <% if can_trust_sender %>
          <span aria-hidden="true">&middot;</span>
          <%= button_to "Always for this sender", tool_mail_trusted_sender_path(message.account.tool, message),
                class: "email-images-action", form_class: "contents", title: "Always show images from #{message.from_address}",
                aria: { label: "Always show images from #{message.from_address}" } %>
        <% end %>
      </div>
    <% end %>
    <div class="email-frame" data-email-frame-target="card">
      <iframe
        sandbox="allow-same-origin allow-popups allow-popups-to-escape-sandbox"
        srcdoc="<%= images_trusted ? full_srcdoc : safe_srcdoc %>"
        data-email-frame-target="frame"
        style="width: 100%; border: none; height: 0; overflow: hidden; display: block;"
      ></iframe>
    </div>
  </div>
<% elsif message.body_plain.present? %>
  <div class="whitespace-pre-wrap text-text-primary text-sm"><%=
    message.body_plain
  %></div>
<% else %>
  <p class="text-text-tertiary italic text-sm">No content</p>
<% end %>
