  <%# Hidden hotkey triggers for keyboard navigation %>
  <button data-controller="hotkey" data-hotkey="j" data-action="click->mail-keyboard#selectNext" hidden><%= _("Next") %></button>
  <button data-controller="hotkey" data-hotkey="k" data-action="click->mail-keyboard#selectPrevious" hidden><%= _("Previous") %></button>
  <button data-controller="hotkey" data-hotkey="o" data-action="click->mail-keyboard#openSelected" hidden><%= _("Open") %></button>
  <%# (no shortcut on Enter: it presses whatever has the keyboard, a conversation or a folder) %>
  <%# The arrow keys are mail_keyboard_controller.js's own: through the list, into a
      conversation and back out of it %>
