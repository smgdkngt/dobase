  <div class="tool-scroll-area mail-list-panel bg-surface border-e border-border-light overflow-y-auto flex flex-col" data-mail-keyboard-target="list">
    <%# A sync that went wrong would otherwise look like a quiet inbox %>
    <% if @mail_account.sync_error? %>
      <div class="mail-sync-problem" role="alert">
        <%= render "shared/icon", name: "alert-circle", size: 16, class: "shrink-0 mt-0.5" %>
        <div class="min-w-0 flex-1">
          <p class="mail-sync-problem-text"><%= mail_sync_problem(@mail_account) %></p>
          <div class="mail-sync-problem-actions">
            <%= render "components/button", text: _("Try again"), icon: "refresh-cw", size: :sm, variant: :secondary,
                  href: tool_sync_path(@tool), method: :post %>
            <% if @tool.owned_by?(current_user) %>
              <%= render "components/button", text: _("Settings"), icon: "settings", size: :sm, variant: :ghost,
                    href: edit_tool_path(@tool, tab: "email") %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @current_folder == "trash" && @trash_count > 0 %>
      <div class="flex items-center justify-between px-3 py-2 bg-warning-light border-b border-warning text-[0.8125rem] text-warning">
        <span><%= _("Messages in Trash are deleted forever after 30 days") %></span>
        <%= button_to _("Empty Trash"), tool_empty_trash_path(@tool), method: :delete, class: "text-xs font-medium hover:underline", data: { turbo_confirm: _("Permanently delete all messages in Trash?"), turbo_confirm_button: _("Empty trash") } %>
      </div>
    <% end %>

    <% if @current_folder == "junk" && @conversations.any? %>
      <div class="flex items-center gap-2 px-3 py-2 bg-background-secondary border-b border-border-light text-[0.8125rem] text-text-secondary">
        <%= render "shared/icon", name: "shield-alert", size: 14, class: "shrink-0" %>
        <span><%= _("Mail your server took for junk. Images stay hidden.") %></span>
      </div>
    <% end %>

    <% if params[:q].present? %>
      <%= render "tools/mails/search_header" %>
    <% end %>

    <%= form_with url: tool_bulk_path(@tool), method: :post, id: "bulk-form", data: { controller: "mail-bulk" } do %>
      <%# A search over every folder acts on each conversation where it is %>
      <% listed = @searching_in || @current_folder %>
      <input type="hidden" name="folder" value="<%= listed %>">

      <% if @conversations.any? %>
        <div class="flex items-center px-3 py-0.5 min-h-9 border-b border-border-light bg-background-secondary gap-3">
          <input type="checkbox" class="w-4 h-4 rounded accent-accent ms-[2px]" aria-label="<%= _("Select all conversations") %>" data-mail-bulk-target="selectAll" data-action="change->mail-bulk#toggleAll">
          <div class="flex items-center gap-1 hidden" data-mail-bulk-target="actions">
            <% if listed == "trash" %>
              <%= render "components/icon_button", icon: "trash-2", title: _("Delete forever"), type: :submit, name: "action_type", value: "delete", size: :sm %>
              <%= render "components/icon_button", icon: "rotate-ccw", title: _("Restore"), type: :submit, name: "action_type", value: "restore", size: :sm %>
            <% else %>
              <% if listed == "junk" %>
                <%= render "components/icon_button", icon: "shield-check", title: _("Not junk (e)"), type: :submit, name: "action_type", value: "not_junk", size: :sm %>
              <% elsif listed != "archive" %>
                <%= render "components/icon_button", icon: "archive", title: _("Archive (e)"), type: :submit, name: "action_type", value: "archive", size: :sm, data: { sound: "tuck" } %>
              <% end %>
              <%= render "components/icon_button", icon: "trash-2", title: _("Delete (#)"), type: :submit, name: "action_type", value: "trash", size: :sm, data: { sound: "trash" } %>
              <div class="relative">
                <button type="button"
                        class="icon-btn icon-btn-sm"
                        title="<%= _("Move to folder") %>"
                        popovertarget="bulk-move-menu"
                        style="anchor-name: --bulk-move-btn">
                  <%= render "shared/icon", name: "folder-input", size: 14 %>
                </button>
                <div id="bulk-move-menu" popover="auto" class="popover-menu"
                     style="position-anchor: --bulk-move-btn; position-area: block-end span-inline-start">
                  <%
                    bulk_move_folders = [["INBOX", "inbox", _("Inbox")], ["Sent", "send", _("Sent")]]
                    @custom_folders.each { |f| bulk_move_folders << [f, "folder", mail_folder_name(f)] }
                  %>
                  <% bulk_move_folders.each do |folder_name, icon, label| %>
                    <button type="button" class="dropdown-item flex items-center gap-2"
                            data-action="mail-bulk#moveToFolder" data-folder="<%= folder_name %>">
                      <%= render "shared/icon", name: icon, size: 16 %>
                      <span><%= label %></span>
                    </button>
                  <% end %>
                  <% if @mail_account.junk_folder? && listed != "junk" %>
                    <div class="dropdown-divider"></div>
                    <button type="submit" class="dropdown-item flex items-center gap-2" name="action_type" value="junk">
                      <%= render "shared/icon", name: "shield-alert", size: 16 %>
                      <span><%= _("Junk") %></span>
                    </button>
                  <% end %>
                </div>
              </div>
              <%= render "components/icon_button", icon: "mail-open", title: _("Mark as read"), type: :submit, name: "action_type", value: "mark_read", size: :sm %>
              <%= render "components/icon_button", icon: "mail", title: _("Mark as unread (u)"), type: :submit, name: "action_type", value: "mark_unread", size: :sm %>
            <% end %>
          </div>
          <span class="text-xs text-text-tertiary ms-auto"><%= n_("%{count} message", "%{count} messages", @total_count) %></span>
        </div>
      <% end %>

      <div class="mail-list-scroll flex-1 overflow-y-auto" data-controller="mail-swipe">
        <% if @conversations.any? %>
          <%= render partial: "tools/mails/conversation_item",
                  collection: @conversations, as: :conversation,
                  locals: { tool: @tool, current_folder: @current_folder, selected_message: @selected_message || @composing_from || @draft, searching: params[:q].present? } %>

          <% if @total_pages > 1 %>
            <div class="p-3 flex items-center justify-center gap-2 border-t border-border-light">
              <% if @page > 1 %>
                <%= render "components/icon_button",
                    icon: "chevron-left",
                    title: _("Previous page"),
                    href: tool_mails_path(@tool, folder: @current_folder, page: @page - 1, **mail_search_params) %>
              <% end %>
              <span class="text-xs text-text-tertiary"><%= @page %> / <%= @total_pages %></span>
              <% if @page < @total_pages %>
                <%= render "components/icon_button",
                    icon: "chevron-right",
                    title: _("Next page"),
                    href: tool_mails_path(@tool, folder: @current_folder, page: @page + 1, **mail_search_params) %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <%
            folder_icons = { "inbox" => "inbox", "drafts" => "file-pen", "starred" => "star", "sent" => "send", "archive" => "archive", "junk" => "shield-alert", "trash" => "trash-2" }
            folder_descriptions = { "inbox" => _("Your inbox is empty"), "drafts" => _("No drafts"), "starred" => _("No starred messages"), "sent" => _("No sent messages"), "archive" => _("No archived messages"), "junk" => _("No junk mail"), "trash" => _("Trash is empty") }
            empty_icon = folder_icons[@current_folder] || "folder"
            empty_title = params[:q].present? ? _("No results found") : _("No messages")
            empty_description = params[:q].present? ? (@searching_in == "all" ? _("Nothing in any folder matches. Trash and junk aren't searched unless you pick them.") : _("Try a different search term, or search all folders")) : (folder_descriptions[@current_folder] || _("No messages in %{mail_folder_name}", mail_folder_name: mail_folder_name(@current_folder)))
          %>
          <%= render "components/empty_state",
              icon: empty_icon,
              title: empty_title,
              description: empty_description %>
        <% end %>
      </div>
    <% end %>
  </div>
