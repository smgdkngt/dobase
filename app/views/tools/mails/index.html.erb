<% content_for :title, "#{@tool.name} - #{app_name}" %>
<% content_for :page_title, "" %>

<%= render "tools/mails/shortcuts" %>


<div class="tool-layout mail-layout <%= 'mail-detail-open' if @selected_message %>"
     data-controller="mail-keyboard mail-refresh"
     data-mail-refresh-interval-value="<%= @mail_account.authentication_failed? ? 0 : (@mail_account.auto_refresh_interval || 60) %>"
     data-mail-refresh-url-value="<%= tool_sync_path(@tool) %>">
  <%= render "tools/mails/hotkeys" %>

  <%= render "tools/mails/topbar" %>


  <!-- Message List -->
  <%= render "tools/mails/list_panel" %>

  <%= render "tools/mails/detail_panel" %>
</div>
