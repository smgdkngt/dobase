<% content_for :title, [ (@heading if @composing), @tool.name, app_name ].compact.join(" - ") %>
<% content_for :page_title, "" %>
<% if @composing %>
  <%# A failed send renders the compose form again at the same address. Morphing it would empty
      the recipient tags and the editor without starting their controllers again. %>
  <% content_for :turbo_refresh_method, "replace" %>
<% end %>

<%= render "tools/mails/shortcuts" %>


<%# Refreshing reloads the page, which would take a message that is being written with it %>
<div class="tool-layout mail-layout <%= 'mail-detail-open' if @selected_message || @composing %>"
     data-controller="mail-keyboard mail-refresh"
     data-mail-refresh-interval-value="<%= @mail_account.authentication_failed? || @composing ? 0 : (@mail_account.auto_refresh_interval || 60) %>"
     data-mail-refresh-url-value="<%= tool_sync_path(@tool) %>">
  <%= render "tools/mails/hotkeys" %>

  <%= render "tools/mails/topbar" %>

  <nav class="tool-scroll-area mail-folder-rail" aria-label="Mail folders">
    <%= render "tools/mails/folder_links", rail: true,
          folders: mail_folders(inbox_unread: @inbox_unread, drafts_count: @drafts_count, trash_count: @trash_count) %>
  </nav>

  <!-- Message List -->
  <%= render "tools/mails/list_panel" %>

  <%= render "tools/mails/detail_panel" %>
</div>
