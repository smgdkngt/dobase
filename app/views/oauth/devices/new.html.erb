<% content_for :title, _("Connect the command line - %{app_name}", app_name: app_name) %>

<div class="flex items-center justify-center min-h-full py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
      <% if @device %>
        <h1 class="text-2xl font-semibold text-text-primary"><%= _("Connect %{client_name}", client_name: @device.client.name) %></h1>
        <p class="text-text-secondary mt-1">
          <%= _("It asks to work in %{app_name} as %{email}. Only say yes if you just ran %{command} and it shows %{code}.", app_name: app_name, email: tag.strong(current_user.email_address), command: tag.code("dobase login"), code: tag.strong(@device.user_code)) %>
        </p>
      <% else %>
        <h1 class="text-2xl font-semibold text-text-primary"><%= _("Connect the command line") %></h1>
        <p class="text-text-secondary mt-1"><%= _("Type the code") %> <code>dobase login</code> shows.</p>
      <% end %>
    </div>

    <div class="auth-card">
      <div class="card-body">
        <%= render "shared/flash", position: :inline %>
        <% if @device %>
          <%= form_with url: oauth_device_path, method: :post, data: { turbo: false } do %>
            <%= hidden_field_tag :user_code, @device.user_code, id: nil %>
            <p class="text-sm text-text-secondary mb-4">
              <%= _("It sees the tools you have, as you see them, and nothing that is only yours to manage. The connection shows under Profile, API, where you can end it. It ends by itself after thirty days unused.") %>
            </p>
            <div class="space-y-3 mb-6">
              <%= render "components/form_field",
                    label: _("It may"),
                    name: "permission",
                    type: :select,
                    value: "write",
                    options: [ [ _("Read and change things"), "write" ], [ _("Only read"), "read" ] ] %>
              <%= render "components/form_field",
                    label: _("What it writes shows as"),
                    name: "agent",
                    type: :select,
                    value: "true",
                    options: [ [ _("%{client} for %{name}", client: @device.client.name, name: current_user.first_name), "true" ], [ _("%{name}, via %{client}", name: current_user.name, client: @device.client.name), "false" ] ] %>
            </div>
            <div class="flex flex-col gap-2">
              <%= render "components/button", text: _("Allow"), name: "decision", value: "allow", full_width: true %>
              <%= render "components/button", text: _("Deny"), name: "decision", value: "deny", variant: :ghost, full_width: true %>
            </div>
          <% end %>
        <% else %>
          <%= form_with url: new_oauth_device_path, method: :get, data: { turbo: false } do %>
            <%= render "components/form_field",
                  label: _("Code"),
                  name: "user_code",
                  value: @user_code,
                  required: true,
                  placeholder: _("BCDF-GHJK"),
                  error: @user_code.present? ? _("That code isn't valid, or has expired.") : nil %>
            <%= render "components/button", text: _("Continue"), full_width: true %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
