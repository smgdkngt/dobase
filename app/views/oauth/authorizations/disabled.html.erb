<% content_for :title, _("Connections are off - %{app_name}", app_name: app_name) %>

<div class="flex items-center justify-center min-h-full py-12">
  <div class="w-full max-w-sm text-center">
    <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
    <h1 class="text-2xl font-semibold text-text-primary"><%= _("Connections are off") %></h1>
    <p class="text-text-secondary mt-2">
      <%= _("You switched off connections from Claude and other programs. Switch them on under Profile, API to connect.") %>
    </p>
  </div>
</div>
