<% content_for :title, "Connect #{@authorization.client.name} - #{app_name}" %>

<div class="flex items-center justify-center min-h-full py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
      <h1 class="text-2xl font-semibold text-text-primary">Connect <%= @authorization.client.name %></h1>
      <p class="text-text-secondary mt-1">
        It asks to work in <%= app_name %> as <strong><%= current_user.email_address %></strong>,
        from <%= @authorization.destination %>.
      </p>
    </div>

    <div class="auth-card">
      <div class="card-body">
        <%= form_with url: oauth_authorization_path, method: :post, data: { turbo: false } do %>
          <% @authorization.form_fields.each do |name, value| %>
            <%= hidden_field_tag name, value, id: nil %>
          <% end %>

          <p class="text-sm text-text-secondary mb-4">
            It sees the tools you have, as you see them, and nothing that is only yours to manage:
            your account, mail and calendar logins, and who a tool is shared with. Every call it makes
            is listed under Profile, API, where you can end the connection.
          </p>

          <div class="space-y-3 mb-6">
            <%= render "components/form_field",
                  label: "It may",
                  name: "permission",
                  type: :select,
                  value: "write",
                  options: [ [ "Read and change things", "write" ], [ "Only read", "read" ] ] %>
            <%= render "components/form_field",
                  label: "What it writes shows as",
                  name: "agent",
                  type: :select,
                  value: "true",
                  options: [ [ "#{@authorization.client.name} for #{current_user.first_name}", "true" ],
                             [ "#{current_user.name}, via #{@authorization.client.name}", "false" ] ] %>
          </div>

          <div class="flex flex-col gap-2">
            <%= render "components/button", text: "Allow", name: "decision", value: "allow", full_width: true %>
            <%= render "components/button", text: "Deny", name: "decision", value: "deny", variant: :ghost, full_width: true %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
