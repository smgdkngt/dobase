<% content_for :title, _("Connect %{name} - %{app_name}", name: @authorization.client.name, app_name: app_name) %>

<div class="flex items-center justify-center min-h-full py-12">
  <div class="w-full max-w-md">
    <div class="text-center mb-8">
      <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
      <h1 class="text-2xl font-semibold text-text-primary"><%= _("Connect %{client_name}", client_name: @authorization.client.name) %></h1>
      <p class="text-text-secondary mt-1">
        <%= _("It asks to work in %{app_name} as %{email}, from %{destination}.", app_name: app_name, email: tag.strong(current_user.email_address), destination: @authorization.destination) %>
      </p>
    </div>

    <div class="auth-card">
      <div class="card-body">
        <%= form_with url: oauth_authorization_path, method: :post, data: { turbo: false } do %>
          <% @authorization.form_fields.each do |name, value| %>
            <%= hidden_field_tag name, value, id: nil %>
          <% end %>

          <p class="text-sm text-text-secondary mb-4">
            <%= _("It sees the tools you have, as you see them, and nothing that is only yours to manage: your account, mail and calendar logins, and who a tool is shared with. Every call it makes is listed under Profile, API, where you can end the connection.") %>
          </p>

          <div class="space-y-3 mb-6">
            <%= render "components/form_field",
                  label: _("It may"),
                  name: "permission",
                  type: :select,
                  value: "write",
                  options: [ [ _("Read and change things"), "write" ], [ _("Only read"), "read" ] ] %>
            <%= render "components/form_field",
                  label: _("What it writes shows as"),
                  name: "agent",
                  type: :select,
                  value: "true",
                  options: [ [ _("%{client} for %{name}", client: @authorization.client.name, name: current_user.first_name), "true" ],
                             [ _("%{name}, via %{client}", name: current_user.name, client: @authorization.client.name), "false" ] ] %>
          </div>

          <div class="flex flex-col gap-2">
            <%= render "components/button", text: _("Allow"), name: "decision", value: "allow", full_width: true %>
            <%= render "components/button", text: _("Deny"), name: "decision", value: "deny", variant: :ghost, full_width: true %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
