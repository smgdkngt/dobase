<%= turbo_frame_tag "notifications" do %>
  <div class="flex items-center justify-between px-4 py-3 border-b border-border-light">
    <h3 class="text-sm font-semibold text-text-primary">Notifications</h3>
    <% if @notifications.any? %>
      <div class="flex items-center gap-1">
        <% if @notifications.any?(&:unread?) %>
          <%= button_to notification_reads_path, method: :post,
                class: "text-xs text-text-secondary hover:text-text-primary cursor-pointer bg-transparent border-none px-2 py-1 rounded hover:bg-background-tertiary transition-colors",
                data: { notifications_target: "markAllRead", action: "notifications#markAllRead" } do %>
            Mark all read
          <% end %>
        <% end %>
        <button type="button" class="text-xs text-text-secondary hover:text-text-primary cursor-pointer bg-transparent border-none px-2 py-1 rounded hover:bg-background-tertiary transition-colors"
                data-action="notifications#clearAll">
          Clear all
        </button>
      </div>
    <% end %>
  </div>

  <%# Shown by notifications_controller.js while the browser hasn't been asked yet %>
  <div class="notification-desktop-offer" hidden data-notifications-target="desktopOffer">
    <%= render "shared/icon", name: "bell", size: 14 %>
    <span>Get a desktop notification when <%= app_name %> is in another tab.</span>
    <button type="button" class="notification-desktop-offer-button" data-action="notifications#enableDesktop">Turn on</button>
  </div>

  <% if @notifications.any? %>
    <div class="max-h-[min(70vh,32rem)] overflow-y-auto scrollbar-thin" data-notifications-target="list">
      <% NotificationFeed.new(@notifications).entries.each do |entry| %>
        <%= render "notifications/entry", entry: entry %>
      <% end %>
    </div>
  <% else %>
    <div class="px-4 py-8 text-center">
      <div class="text-text-tertiary mb-1">
        <%= render "shared/icon", name: "bell", size: 24, class: "mx-auto text-text-tertiary" %>
      </div>
      <p class="text-sm text-text-secondary">No notifications</p>
    </div>
  <% end %>
<% end %>
