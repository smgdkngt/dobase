<%# What the command palette shows under the tools once you type: the frame's
    items are palette items, so the arrow keys and Enter reach them too. A kind
    with more than a few results ends in "Show all", which loads every one of
    that kind into this frame (a button: Enter clicks it and the palette stays). %>
<%= turbo_frame_tag "command_palette_search" do %>
  <% if @search.searchable? %>
    <div class="px-4 py-1.5 flex items-center gap-2" data-section="search">
      <span class="flex-1 text-xs font-semibold text-text-tertiary uppercase tracking-wider">
        <%= @search.kind ? "All #{search_kind_count(@search, @search.kind)}" : "Found in your tools" %>
      </span>
    </div>
    <% if @search.kind %>
      <%= button_to search_path, method: :get, params: { q: @search.query },
            class: "command-palette-item w-full text-left text-text-secondary",
            data: { command_palette_target: "item", search_result: true, action: "click->command-palette#keepTyping", name: "", type: "search" } do %>
        <%= render "shared/icon", name: "arrow-left", size: 16, class: "text-text-tertiary shrink-0" %>
        <span class="flex-1">Back to everything found</span>
      <% end %>
    <% end %>
    <% if @search.hits.empty? %>
      <p class="px-4 py-2 text-sm text-text-tertiary">Nothing matches “<%= @search.query %>”.</p>
    <% else %>
      <% @search.hits.chunk_while { |a, b| a.kind == b.kind }.each do |group| %>
        <% group.each do |hit| %>
          <%= link_to hit.path, class: "command-palette-item",
                data: { turbo_frame: "_top", command_palette_target: "item", search_result: true, name: hit.title.downcase, type: "search", archived: hit.archived || nil } do %>
            <%= render "shared/icon", name: search_icon(hit.kind), size: 16, class: "text-text-tertiary shrink-0" %>
            <span class="flex-1 min-w-0">
              <span class="flex items-center gap-2 min-w-0">
                <span class="truncate"><%= search_marked(hit.title, @search.words) %></span>
                <% if hit.archived %>
                  <%= render "components/badge", text: "Archived", variant: :muted, size: :sm %>
                <% end %>
              </span>
              <% if hit.excerpt.present? %>
                <span class="block truncate text-xs text-text-tertiary"><%= search_marked(hit.excerpt, @search.words) %></span>
              <% end %>
            </span>
            <span class="flex flex-col items-end shrink-0 max-w-[40%] text-xs text-text-tertiary">
              <span class="truncate max-w-full"><%= hit.tool&.display_name %></span>
              <% if hit.date %>
                <time datetime="<%= hit.date.iso8601 %>"><%= format_date(hit.date) %></time>
              <% end %>
            </span>
          <% end %>
        <% end %>
        <% kind = group.first.kind %>
        <% if @search.more?(kind) %>
          <%= button_to search_path, method: :get, params: { q: @search.query, kind: kind },
                class: "command-palette-item w-full text-left text-text-secondary",
                data: { command_palette_target: "item", search_result: true, action: "click->command-palette#keepTyping", name: "", type: "search" } do %>
            <%= render "shared/icon", name: "chevron-down", size: 16, class: "text-text-tertiary shrink-0" %>
            <span class="flex-1">Show all <%= search_kind_count(@search, kind) %></span>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
