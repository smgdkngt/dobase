<% content_for :title, _("Reset Password - %{app_name}", app_name: app_name) %>

<div class="w-full max-w-sm">
  <div class="text-center mb-8">
    <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
    <h1 class="text-2xl font-semibold text-text-primary"><%= _("Reset your password") %></h1>
    <p class="text-text-secondary mt-1"><%= _("We'll send you a reset link") %></p>
  </div>

  <div class="auth-card">
    <div class="card-body">
      <%= render "shared/flash", position: :inline %>
      <%= form_with url: passwords_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="email_address" class="label"><%= _("Email") %></label>
          <%= f.email_field :email_address,
            class: "input",
            placeholder: "you@example.com",
            required: true,
            autofocus: true,
            autocomplete: "email",
            value: params[:email_address]
          %>
        </div>

        <%= render "components/button", text: _("Send Reset Link"), full_width: true %>
      <% end %>
    </div>
  </div>

  <p class="text-center text-sm text-text-secondary mt-6">
    <%= _("Remember your password?") %>
    <%= link_to _("Sign in"), login_path, class: "text-accent hover:underline font-medium" %>
  </p>
</div>
