<%# locals: text, url %>
<table role="presentation" cellpadding="0" cellspacing="0">
  <tr>
    <td style="border-radius: 8px; background-color: <%= mail_color(:button) %>;" class="btn-primary">
      <%= link_to text, url,
          style: "display: inline-block; padding: 12px 28px; color: #{mail_color(:on_button)}; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; font-family: #{mail_font};" %>
    </td>
  </tr>
</table>
