<%# A second tool beside the one you have open (side_pane_controller.js). The pane is
    taken from this template and put next to <body>, not in it: Turbo swaps the body
    on every visit, and a frame that moves loads its page again. Out there the tool
    beside stays as it is while the main one goes from page to page. %>
<template id="side-pane-template">
  <aside id="side-pane" class="side-pane" aria-label="Beside" hidden
         data-controller="side-pane"
         data-side-pane-user-id-value="<%= current_user.id %>">
    <div class="side-pane-resizer" role="separator" aria-orientation="vertical"
         aria-label="Width of the tool beside" tabindex="0"
         data-side-pane-target="resizer"
         data-action="pointerdown->side-pane#startResize dblclick->side-pane#resetWidth keydown->side-pane#resizeWithKeys"></div>
    <div class="side-pane-controls">
      <%= render "components/icon_button", icon: "arrow-left-right", title: "Swap sides", size: :sm,
            data: { action: "click->side-pane#swap" } %>
      <%= render "components/icon_button", icon: "x", title: "Close the tool beside", size: :sm,
            data: { action: "click->side-pane#close" } %>
    </div>
    <div class="side-pane-frame" data-side-pane-target="slot"></div>
    <%# F6 goes to the tool beside, and from there back (layouts/application) %>
    <button data-controller="hotkey" data-hotkey="F6" data-action="click->side-pane#focus" hidden>To the tool beside</button>
  </aside>
</template>
