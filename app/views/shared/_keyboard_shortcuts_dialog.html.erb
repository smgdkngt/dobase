<dialog class="modal-dialog max-w-lg"
        aria-labelledby="keyboard-shortcuts-title"
        data-keyboard-shortcuts-target="dialog"
        data-controller="modal arrow-keys">
  <div class="modal-header">
    <h2 id="keyboard-shortcuts-title" class="text-lg font-semibold text-text-primary">Keyboard shortcuts</h2>
    <%= render "components/icon_button", icon: "x", title: "Close",
        data: { action: "click->modal#close" } %>
  </div>
  <div class="modal-body space-y-6 max-h-[70vh] overflow-y-auto" data-arrow-keys-target="scroller">
    <div>
      <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Global</h3>
      <div class="shortcut-list">
        <%= render "shared/shortcut_row", key: "?", description: "Show keyboard shortcuts" %>
        <%= render "shared/shortcut_row", key: launcher_key, description: (@workspace || tile? ? "Open the menu: your tools, and search" : "Jump to tool") %>
        <%= render "shared/shortcut_row", key: "b", description: "Notifications" %>
        <%= render "shared/shortcut_row", key: "← → ↑ ↓", description: "Go through what is on the page" %>
        <%= render "shared/shortcut_row", key: "Home / End", description: "As far as it goes, up or down" %>
        <%= render "shared/shortcut_row", key: "Page Up / Down", description: "About a screen up or down" %>
      </div>
    </div>

    <%= content_for(:keyboard_shortcuts) %>

    <%# In a tile: the keys of the workspace around it %>
    <%= render "workspaces/shortcuts" if tile? %>
  </div>
</dialog>
