<%# What a right click on a tool in the menu offers. Locals: instance, muted %>
<%= render "components/context_menu", label: _("Tool: %{display_name}", display_name: instance.display_name) do %>
  <%= render "components/menu_item", text: _("Open"), icon: "eye", href: tool_path(instance) %>
  <%= render "components/menu_item", text: _("Settings"), icon: "settings", data: { context_menu_press: "settings" } %>
  <%= render "components/menu_item", text: muted ? _("Unmute notifications") : _("Mute notifications"), icon: muted ? "bell" : "bell-off",
        href: tool_mute_path(instance), method: muted ? :delete : :post %>
  <%= render "components/menu_divider" %>
  <%= render "components/menu_item", text: _("Copy link"), icon: "link", data: { copy: tool_url(instance) } %>
<% end %>
