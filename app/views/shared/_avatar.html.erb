<%#
  Avatar component
  Usage:
    render "shared/avatar", user: current_user
    render "shared/avatar", user: current_user, size: :lg
    render "shared/avatar", initials: "JD", size: :sm
    render "shared/avatar", user: message.user, agent: message.agent?

  Options:
    user: User object (will use avatar or generate initials from name)
    agent: true for something an agent posted on the user's behalf (a bot, not their face)
    initials: Custom initials (used if no user provided)
    size: :sm, :md (default), :lg, :xl, :"2xl"
    class: Additional CSS classes
%>
<%
  user = local_assigns[:user] unless local_assigns[:agent]
  initials = local_assigns[:initials]
  size = local_assigns[:size] || :md
  extra_class = local_assigns[:class] || ""

  size_classes = {
    sm: "avatar-sm",
    md: "avatar-md",
    lg: "avatar-lg",
    xl: "avatar-xl",
    "2xl": "avatar-2xl"
  }

  if user
    # A rejected upload (wrong type, too big) is still attached in memory on the
    # form's re-render, but its blob was never stored — asking for its URL raises.
    if user.avatar.attached? && user.avatar.blob&.persisted?
      has_image = true
      image_url = url_for(user.avatar.variant(resize_to_fill: [200, 200]))
    else
      has_image = false
      initials = "#{user.first_name[0]}#{user.last_name[0]}".upcase
      # Their own colours and shape behind the letters (User#avatar_look)
      look = user.avatar_look
    end
  else
    has_image = false
    initials ||= "?"
  end
%>
<%= tag.div class: [ "avatar", size_classes[size], extra_class.presence ],
      data: (look ? { avatar_hue: look[:hue], avatar_second: look[:second], avatar_pattern: look[:pattern] } : nil) do %>
  <% if local_assigns[:agent] %>
    <%= render "shared/icon", name: "bot", size: { sm: 14, md: 18, lg: 22, xl: 24, "2xl": 32 }[size], label: "Agent" %>
  <% elsif has_image %>
    <%= image_tag image_url, alt: user&.name || "Avatar", class: "w-full h-full object-cover" %>
  <% else %>
    <span><%= initials %></span>
  <% end %>
<% end %>
