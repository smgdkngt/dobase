<% content_for :title, _("Verify your identity - %{app_name}", app_name: app_name) %>

<div class="w-full max-w-sm">
  <div class="text-center mb-8">
    <%= render "shared/logo", class: "w-16 h-16 mx-auto mb-4" %>
    <h1 class="text-2xl font-semibold text-text-primary"><%= _("Check your authenticator app") %></h1>
    <p class="text-text-secondary mt-1"><%= _("Enter the 6-digit code to continue signing in") %></p>
  </div>

  <div class="auth-card">
    <div class="card-body" data-controller="recovery-code">
      <%= render "shared/flash", position: :inline %>
      <%= form_with url: two_factor_challenge_path, method: :post, class: "space-y-4" do |f| %>
        <div>
          <label for="code" class="label"><%= _("Verification code") %></label>
          <%= f.text_field :code,
            class: "input text-center text-lg tracking-widest",
            placeholder: "000 000",
            required: true,
            autofocus: true,
            autocomplete: "one-time-code",
            inputmode: "numeric",
            maxlength: 8,
            data: { recovery_code_target: "field" }
          %>
        </div>

        <%= render "components/button", text: _("Verify"), full_width: true %>
      <% end %>

      <p class="text-center text-sm text-text-tertiary mt-3" data-recovery-code-target="prompt">
        <%= _("Lost your device?") %>
        <button type="button" class="text-accent hover:underline" data-action="recovery-code#reveal">
          <%= _("Use a recovery code") %>
        </button>
      </p>
    </div>
  </div>

  <p class="text-center text-sm text-text-secondary mt-6">
    <%= link_to _("Sign in with a different account"), new_session_path, class: "text-accent hover:underline font-medium" %>
  </p>
  <p class="text-center text-xs text-text-tertiary mt-4">
    <%= _("Powered by") %> <a href="https://dobase.co" class="hover:underline" target="_blank"><%= app_name %></a>
  </p>
</div>
