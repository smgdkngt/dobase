<!DOCTYPE html>
<html data-turbo-not-loaded <%= tag.attributes(theme_attributes) %><%= " data-in-tile" if tile? %>>
  <head>
    <title><%= content_for(:title) || app_name %></title>
    <meta name="viewport" content="<%= viewport_content %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="application-name" content="<%= app_name %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%# A theme's own chrome colour goes first, so it wins over the two below %>
    <% if current_theme %><meta name="theme-color" content="<%= current_theme.chrome_color %>" data-theme-chrome><% end %>
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#2c2c2e" media="(prefers-color-scheme: dark)">
    <%= csrf_meta_tags %>
    <meta name="time-zone" content="<%= Time.zone.tzinfo.name %>">
    <%= csp_meta_tag %>
    <%# No prefetch on hover: page visits have effects (marking mail read, the docs edit lock, activity dots) %>
    <meta name="turbo-prefetch" content="false">
    <%# A page whose widgets can't be morphed (the compose form) asks for "replace" %>
    <meta name="turbo-refresh-method" content="<%= content_for(:turbo_refresh_method).presence || "morph" %>">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%# A page that is a tile goes without the cross-fade: Turbo waits for it, three
        times as long as the page itself takes %>
    <% unless tile? %><meta name="view-transition" content="same-origin"><% end %>

    <%= yield :head %>

    <%# A tool opened by its address (a link in a mail, a bookmark) in a window wide
        enough for tiles becomes a tile in the workspace, before anything is drawn
        (workspace_gate.js). Never for a page that is itself in a frame. %>
    <% if user_signed_in? && workspace_wanted? && !tile? && !@workspace && request.get? && request.path.match?(%r{\A/tools/\d+}) %>
      <%= javascript_include_tag "workspace_gate", data: { wide: workspace_path(open: request.fullpath) } %>
    <% end %>

    <%# With credentials, so the manifest can carry the colours of this browser's theme %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json), crossorigin: "use-credentials" %>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <%# iOS splash screens — generated with pwa-asset-generator %>
    <link rel="apple-touch-startup-image" href="/apple-splash-2048-2732.png" media="(device-width: 1024px) and (device-height: 1366px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1668-2388.png" media="(device-width: 834px) and (device-height: 1194px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1536-2048.png" media="(device-width: 768px) and (device-height: 1024px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1640-2360.png" media="(device-width: 820px) and (device-height: 1180px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1668-2224.png" media="(device-width: 834px) and (device-height: 1112px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1620-2160.png" media="(device-width: 810px) and (device-height: 1080px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1488-2266.png" media="(device-width: 744px) and (device-height: 1133px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1320-2868.png" media="(device-width: 440px) and (device-height: 956px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1206-2622.png" media="(device-width: 402px) and (device-height: 874px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1260-2736.png" media="(device-width: 420px) and (device-height: 912px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1290-2796.png" media="(device-width: 430px) and (device-height: 932px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1179-2556.png" media="(device-width: 393px) and (device-height: 852px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1170-2532.png" media="(device-width: 390px) and (device-height: 844px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1284-2778.png" media="(device-width: 428px) and (device-height: 926px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1125-2436.png" media="(device-width: 375px) and (device-height: 812px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1242-2688.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-828-1792.png" media="(device-width: 414px) and (device-height: 896px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-1242-2208.png" media="(device-width: 414px) and (device-height: 736px) and (-webkit-device-pixel-ratio: 3) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-750-1334.png" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">
    <link rel="apple-touch-startup-image" href="/apple-splash-640-1136.png" media="(device-width: 320px) and (device-height: 568px) and (-webkit-device-pixel-ratio: 2) and (orientation: portrait)">

    <%= stylesheet_link_tag "rhino-editor", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%# After the import map: Firefox ignores an import map that comes after a module
        script has started loading, and then none of the app's JavaScript runs. %>
    <script async defer src="/altcha.min.js" type="module"></script>
  </head>

  <%# data-workspace on the body, not on <html>: Turbo brings a new body with every
      visit and leaves <html> as the first page had it %>
  <body class="bg-background-secondary text-text-primary" data-controller="keyboard-shortcuts theme"
        data-theme-version-value="<%= theme_version %>"<%= " data-workspace" if @workspace %>>
    <%# data-turbo="false" so the browser handles the fragment itself and moves
        focus into <main>; a Turbo anchor visit only scrolls. %>
    <a href="#main-content" class="skip-link" data-turbo="false">Skip to main content</a>
    <%= render "shared/turbo_confirm_dialog" %>
    <% if user_signed_in? && tile? %>
      <%# A tile in the workspace (workspaces/show): the tool alone. The menu, the
          notifications and the launcher belong to the page around the tiles. %>
      <%= render "shared/flash" %>
      <div data-controller="tile-page">
        <main class="main-content" id="main-content" tabindex="-1"
              <%= tag.attributes(main_attributes) %>>
          <%= yield %>
        </main>
        <div id="persistent-room" data-turbo-permanent hidden></div>
        <button data-controller="hotkey" data-hotkey="b" data-action="click->tile-page#notifications" hidden>Notifications</button>
      </div>
      <%# With Shift too: in the workspace Mod+K is the launcher of the page around the tiles %>
      <button data-controller="hotkey" data-hotkey="Mod+k,Mod+Shift+K" data-action="click->keyboard-shortcuts#openCommandPalette" hidden>Command palette</button>
      <%= render "shared/command_palette" %>
      <%= render "shared/keyboard_shortcuts_dialog" %>
    <% elsif user_signed_in? %>
      <%= render "shared/flash" %>
      <div data-controller="mobile-sidebar standalone-scroll">
        <%# Sidebar overlay %>
        <div class="sidebar-overlay" data-mobile-sidebar-target="overlay" data-action="click->mobile-sidebar#close"></div>

        <%= render "shared/sidebar" %>
        <%# A tool page tells everyone else on it that you are here, and what you
            have open; see presence_controller.js and PresenceChannel. %>
        <main class="main-content" id="main-content" tabindex="-1"
              <%= tag.attributes(main_attributes) %>>
          <%= yield %>
        </main>

        <%# Mobile bottom bar — only visible < 1024px %>
        <nav class="mobile-bottom-bar" aria-label="Main">
          <button type="button"
                  class="mobile-bottom-bar-item"
                  aria-label="Account menu for <%= current_user.name %>"
                  aria-haspopup="menu"
                  popovertarget="sidebar-user-menu"
                  style="anchor-name: --mobile-user-btn">
            <%= render "shared/avatar", user: current_user, size: :sm %>
          </button>

          <button type="button"
                  class="mobile-bottom-bar-center"
                  data-action="click->mobile-sidebar#toggle">
            <%= render "shared/logo", class: "w-6 h-6" %>
            <span><%= app_name %></span>
          </button>

          <%
            mobile_unread_count = current_user.notifications.unread.count
          %>
          <div class="relative"
               data-controller="notifications"
               data-notifications-user-id-value="<%= current_user.id %>"
               data-notifications-app-name-value="<%= app_name %>"
               data-notifications-unread-count-value="<%= mobile_unread_count %>"
               data-notifications-unread-mail-count-value="<%= current_user.unread_mail_count %>">
            <button type="button"
                    class="mobile-bottom-bar-item"
                    aria-label="Notifications"
                    popovertarget="sidebar-notifications"
                    style="anchor-name: --mobile-notifications-btn"
                    data-notifications-target="trigger"
                    data-action="click->notifications#togglePopover">
              <%= render "shared/icon", name: "bell", size: 20 %>
              <%# Rendered server-side so a Turbo morph refresh (which restores
                  whatever class the server sends) doesn't reset it to hidden. %>
              <span class="absolute -top-0.5 -right-0.5 badge badge-sm <%= "hidden" if mobile_unread_count.zero? %>"
                    aria-hidden="true"
                    data-notifications-target="badge">
                <%= mobile_unread_count %>
              </span>
            </button>
          </div>
        </nav>

        <div id="persistent-room" data-turbo-permanent hidden></div>
        <%= render "shared/demo_banner" if Demo.enabled? %>
      </div>
      <button data-controller="hotkey" data-hotkey="Mod+k" data-action="click->keyboard-shortcuts#openCommandPalette" hidden>Command palette</button>
      <%= render "shared/command_palette" %>
      <%= render "shared/keyboard_shortcuts_dialog" %>
    <% else %>
      <main class="min-h-dvh flex items-center justify-center bg-background-secondary" id="main-content" tabindex="-1">
        <%= yield %>
      </main>
    <% end %>
  </body>
</html>
