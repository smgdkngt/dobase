<%# The keys of the tiling workspace, for the shortcuts dialog of the workspace itself
    and of every page that is a tile in it %>
<div>
  <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2">Workspace</h3>
  <div class="shortcut-list">
    <%= render "shared/shortcut_row", key: launcher_key, description: "Open a tool as a tile" %>
    <%= render "shared/shortcut_row", key: "⇧ ↵", description: "In the launcher: a tile of its own, also for a tool that is open" %>
    <%= render "shared/shortcut_row", key: "Alt + click", description: "A link in a tile: open it as a tile of its own" %>
    <%= render "shared/shortcut_row", key: (mac? ? "⌘⇧K" : "Ctrl Shift K"), description: "What the tool in this tile can do" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} ← ↑ ↓ →", description: "Go to the tile on that side" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} Shift ← ↑ ↓ →", description: "Move the tile that way" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} 1 – 9", description: "Go to a desktop" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} Shift 1 – 9", description: "Take the tile to a desktop" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} + / −", description: "Make the tile bigger or smaller" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} F", description: "The tile alone, and back" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} W", description: "Close the tile" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} M", description: "The menu with all your tools" %>
    <%= render "shared/shortcut_row", key: "#{workspace_modifier} R", description: "Load the tile again" %>
    <%= render "shared/shortcut_row", key: "F6", description: "On to the next tile" %>
  </div>
</div>
