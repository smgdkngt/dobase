<%# The keys of the tiling workspace, for the shortcuts dialog of the workspace itself
    and of every page that is a tile in it %>
<div>
  <h3 class="text-xs font-semibold text-text-secondary uppercase tracking-wider mb-2"><%= _("Workspace") %></h3>
  <div class="shortcut-list">
    <%= render "shared/shortcut_row", key: "Shift+Enter", description: _("In the menu: open in a new tile, even if the tool is open") %>
    <%= render "shared/shortcut_row", key: (mac? ? "Opt-click" : "Alt-click"), description: _("Open a link in a new tile") %>
    <%= render "shared/shortcut_row", key: mod_key("K", shift: true), description: _("Actions for the tool in this tile") %>
    <%= render "shared/shortcut_row", key: "Esc", description: _("Out of a tool, onto its tile. On a tile: close it") %>
    <%= render "shared/shortcut_row", key: "← → ↑ ↓", description: _("On a tile: to the tile on that side, up to the bar, sideways on to the next desktop") %>
    <%= render "shared/shortcut_row", key: "Enter", description: _("On a tile: into its tool") %>
    <%= render "shared/shortcut_row", key: workspace_key("← → ↑ ↓"), description: _("Go to the tile on that side, from anywhere") %>
    <%= render "shared/shortcut_row", key: workspace_key("← → ↑ ↓", shift: true), description: _("Move the tile that way") %>
    <%= render "shared/shortcut_row", key: workspace_key("1–9"), description: _("Go to a desktop") %>
    <%= render "shared/shortcut_row", key: workspace_key("1–9", shift: true), description: _("Take the tile to a desktop") %>
    <%= render "shared/shortcut_row", key: workspace_key("Plus / Minus"), description: _("Make the tile bigger or smaller") %>
    <%= render "shared/shortcut_row", key: workspace_key("F"), description: _("Show the tile alone, and back") %>
    <%= render "shared/shortcut_row", key: workspace_key("W"), description: _("Close the tile") %>
    <%= render "shared/shortcut_row", key: workspace_key("M"), description: _("Open the menu, as %{launcher_key} does", launcher_key: launcher_key) %>
    <%= render "shared/shortcut_row", key: workspace_key("R"), description: _("Reload the tile") %>
    <%= render "shared/shortcut_row", key: "F6", description: _("Go to the next tile") %>
  </div>
  <p class="mt-2 text-xs text-text-tertiary"><%= _("Every one of these is in the menu too: type what you want to do.") %></p>

  <%# Taken on some machines (a window manager, a screen reader): each browser picks %>
  <label class="workspace-keys-choice">
    <span>
      <span class="block text-sm text-text-primary"><%= _("These keys go with") %></span>
      <span class="block text-xs text-text-tertiary"><%= _("Pick another when they clash with shortcuts you already have. It is kept in this browser.") %></span>
    </span>
    <%# Each choice with how a key written with it begins ("Ctrl+Opt+", "Alt+"): the keys
        this page names are rewritten by it (services/workspace_keys.js) %>
    <%= select_tag :workspace_keys,
          options_for_select(workspace_modifiers.map { |value, (keys, name)| [ name, value, { data: { prefix: "#{keys}+" } } ] }, workspace_modifier),
          id: nil, class: "input w-auto", aria: { label: _("What the workspace's keys go with") },
          data: { controller: "workspace-keys", action: "change->workspace-keys#choose" } %>
  </label>
</div>
